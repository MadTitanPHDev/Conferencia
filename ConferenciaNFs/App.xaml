<Application x:Class="ConferenciaNFs.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:ConferenciaNFs.Infrastructure"
             Startup="Application_Startup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.Light.xaml"/>
                <ResourceDictionary Source="Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <infra:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <infra:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
            <infra:ColumnsFromWidthConverter x:Key="ColumnsFromWidthConverter"/>
            <infra:WidthThresholdToVisibilityConverter x:Key="WidthThresholdToVisibilityConverter"/>
            <infra:WidthThresholdToInverseVisibilityConverter x:Key="WidthThresholdToInverseVisibilityConverter"/>
            <infra:HexToBrushConverter x:Key="HexToBrushConverter"/>
            <infra:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
