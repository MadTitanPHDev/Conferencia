<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paleta Premium Business: #0B1F3F #E8C465 #6E788A #F9FAFC #1F2937 -->
    <SolidColorBrush x:Key="Brush.Background" Color="#F9FAFC"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.SurfaceMuted" Color="#F0F2F5"/>
    <SolidColorBrush x:Key="Brush.Border" Color="#D4D8DE"/>
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#0B1F3F"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#6E788A"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="#E8C465"/>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#D4B054"/>
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#F6EACB"/>
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#0B1F3F"/>
    <SolidColorBrush x:Key="Brush.Brand" Color="#1F2937"/>
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#0B1F3F"/>
    <SolidColorBrush x:Key="Brush.SidebarText" Color="#F9FAFC"/>
    <SolidColorBrush x:Key="Brush.SidebarTextMuted" Color="#6E788A"/>
    <SolidColorBrush x:Key="Brush.SidebarHover" Color="#1F2937"/>
    <SolidColorBrush x:Key="Brush.SidebarActiveText" Color="#0B1F3F"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="#EF4444"/>
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#FEE2E2"/>
    <SolidColorBrush x:Key="Brush.InputBackground" Color="#F9FAFC"/>
    <SolidColorBrush x:Key="Brush.InputFocused" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Hover" Color="#F0F2F5"/>
    <SolidColorBrush x:Key="Brush.RowDefault" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.RowAlternate" Color="#F9FAFC"/>
    <SolidColorBrush x:Key="Brush.GridHeader" Color="#F0F2F5"/>
    <SolidColorBrush x:Key="Brush.SelectionBackground" Color="#F6EACB"/>
    <SolidColorBrush x:Key="Brush.SelectionForeground" Color="#0B1F3F"/>
    <SolidColorBrush x:Key="Brush.Overlay" Color="#990B1F3F"/>
    <SolidColorBrush x:Key="Brush.Shadow" Color="#1F2937"/>
    <SolidColorBrush x:Key="Brush.ScrollTrack" Color="#F0F2F5"/>
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#6E788A"/>

    <SolidColorBrush x:Key="Brush.StatusAmareloForeground" Color="#0B1F3F"/>
    <SolidColorBrush x:Key="Brush.StatusAmareloSelectedForeground" Color="#0B1F3F"/>

    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0B1F3F"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#0B1F3F"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#0B1F3F"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#6E788A"/>

</ResourceDictionary>
