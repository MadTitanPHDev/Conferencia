<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Inspirado no visual escuro do Cursor -->
    <SolidColorBrush x:Key="Brush.Background" Color="#0B0D12"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="#141820"/>
    <SolidColorBrush x:Key="Brush.SurfaceMuted" Color="#34373d"/>
    <SolidColorBrush x:Key="Brush.Border" Color="#2A3140"/>
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#E8ECF4"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#9AA4B8"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="#8B7CF8"/>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#A395FF"/>
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#2A2540"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="#F87171"/>
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#3A2228"/>
    <SolidColorBrush x:Key="Brush.InputBackground" Color="#10141C"/>
    <SolidColorBrush x:Key="Brush.InputFocused" Color="#171C27"/>
    <SolidColorBrush x:Key="Brush.Hover" Color="#1E2431"/>
    <SolidColorBrush x:Key="Brush.RowDefault" Color="#141820"/>
    <SolidColorBrush x:Key="Brush.RowAlternate" Color="#10141C"/>
    <SolidColorBrush x:Key="Brush.GridHeader" Color="#34373d"/>
    <SolidColorBrush x:Key="Brush.Overlay" Color="#CC0B0D12"/>
    <SolidColorBrush x:Key="Brush.Shadow" Color="#000000"/>
    <SolidColorBrush x:Key="Brush.ScrollTrack" Color="#141820"/>
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#3A4254"/>

</ResourceDictionary>
