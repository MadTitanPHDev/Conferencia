<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paleta Premium Business: #0B1F3F #E8C465 #6E788A #F9FAFC #1F2937 -->
    <SolidColorBrush x:Key="Brush.Background" Color="#0B1F3F"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="#1F2937"/>
    <SolidColorBrush x:Key="Brush.SurfaceMuted" Color="#253041"/>
    <SolidColorBrush x:Key="Brush.Border" Color="#6E788A"/>
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#F9FAFC"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#A8B0BC"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="#E8C465"/>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#F0D078"/>
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#C9A54A"/>
    <SolidColorBrush x:Key="Brush.AccentEdge" Color="#A8882A"/>
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#3D3628"/>
    <SolidColorBrush x:Key="Brush.SurfaceEdge" Color="#121821"/>
    <Color x:Key="Color.NeumorphAccentShadow">#E8C465</Color>
    <Color x:Key="Color.NeumorphNeutralShadow">#000000</Color>
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#0B1F3F"/>
    <SolidColorBrush x:Key="Brush.Brand" Color="#0B1F3F"/>
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#081628"/>
    <SolidColorBrush x:Key="Brush.SidebarText" Color="#F9FAFC"/>
    <SolidColorBrush x:Key="Brush.SidebarTextMuted" Color="#C5CDD8"/>
    <SolidColorBrush x:Key="Brush.SidebarHover" Color="#1F2937"/>
    <SolidColorBrush x:Key="Brush.SidebarActiveText" Color="#E8C465"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="#FCA5A5"/>
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#3A2228"/>
    <SolidColorBrush x:Key="Brush.CompareVerdeBg" Color="#86C232"/>
    <SolidColorBrush x:Key="Brush.CompareVerdeFg" Color="#14320A"/>
    <SolidColorBrush x:Key="Brush.CompareAzulBg" Color="#7EB6DB"/>
    <SolidColorBrush x:Key="Brush.CompareAzulFg" Color="#0B2740"/>
    <SolidColorBrush x:Key="Brush.CompareVermelhoBg" Color="#E35D5D"/>
    <SolidColorBrush x:Key="Brush.CompareVermelhoFg" Color="#3B0000"/>
    <SolidColorBrush x:Key="Brush.CompareCinzaBg" Color="#C8CDD3"/>
    <SolidColorBrush x:Key="Brush.CompareCinzaFg" Color="#1F2937"/>
    <SolidColorBrush x:Key="Brush.CompareAmbarBg" Color="#E6B800"/>
    <SolidColorBrush x:Key="Brush.CompareAmbarFg" Color="#3D2E00"/>
    <SolidColorBrush x:Key="Brush.StatusVerdeBg" Color="#86C232"/>
    <SolidColorBrush x:Key="Brush.StatusVerdeFg" Color="#14320A"/>
    <SolidColorBrush x:Key="Brush.StatusAmareloBg" Color="#E6C200"/>
    <SolidColorBrush x:Key="Brush.StatusVermelhoBg" Color="#C62828"/>
    <SolidColorBrush x:Key="Brush.StatusVermelhoFg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.StatusLaranjaBg" Color="#E6A800"/>
    <SolidColorBrush x:Key="Brush.StatusLaranjaFg" Color="#3D2E00"/>
    <SolidColorBrush x:Key="Brush.StatusAzulBg" Color="#1D4F91"/>
    <SolidColorBrush x:Key="Brush.StatusAzulFg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.InputBackground" Color="#162033"/>
    <SolidColorBrush x:Key="Brush.InputFocused" Color="#1F2937"/>
    <SolidColorBrush x:Key="Brush.Hover" Color="#2A3544"/>
    <SolidColorBrush x:Key="Brush.RowDefault" Color="#1F2937"/>
    <SolidColorBrush x:Key="Brush.RowAlternate" Color="#182230"/>
    <SolidColorBrush x:Key="Brush.GridHeader" Color="#253041"/>
    <SolidColorBrush x:Key="Brush.SelectionBackground" Color="#3D3628"/>
    <SolidColorBrush x:Key="Brush.SelectionForeground" Color="#F9FAFC"/>
    <SolidColorBrush x:Key="Brush.Overlay" Color="#CC0B1F3F"/>
    <SolidColorBrush x:Key="Brush.Shadow" Color="#000000"/>
    <SolidColorBrush x:Key="Brush.ScrollTrack" Color="#162033"/>
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#6E788A"/>

    <SolidColorBrush x:Key="Brush.StatusAmareloForeground" Color="#0B1F3F"/>
    <SolidColorBrush x:Key="Brush.StatusAmareloSelectedForeground" Color="#0B1F3F"/>

    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#F9FAFC"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#F9FAFC"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F9FAFC"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#A8B0BC"/>

</ResourceDictionary>
