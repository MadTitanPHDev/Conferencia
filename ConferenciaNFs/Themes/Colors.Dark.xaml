<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Tema escuro com contraste legível em grade, filtros e seleção -->
    <SolidColorBrush x:Key="Brush.Background" Color="#0B0D12"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="#161B24"/>
    <SolidColorBrush x:Key="Brush.SurfaceMuted" Color="#1E2532"/>
    <SolidColorBrush x:Key="Brush.Border" Color="#3A4458"/>
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#C5CEDC"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="#8B7CF8"/>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#A395FF"/>
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#2A2540"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="#F87171"/>
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#3A2228"/>
    <SolidColorBrush x:Key="Brush.InputBackground" Color="#10141C"/>
    <SolidColorBrush x:Key="Brush.InputFocused" Color="#1A2130"/>
    <SolidColorBrush x:Key="Brush.Hover" Color="#252D3C"/>
    <SolidColorBrush x:Key="Brush.RowDefault" Color="#161B24"/>
    <SolidColorBrush x:Key="Brush.RowAlternate" Color="#12171F"/>
    <SolidColorBrush x:Key="Brush.GridHeader" Color="#1E2532"/>
    <SolidColorBrush x:Key="Brush.SelectionBackground" Color="#3B4B6B"/>
    <SolidColorBrush x:Key="Brush.SelectionForeground" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="Brush.Overlay" Color="#CC0B0D12"/>
    <SolidColorBrush x:Key="Brush.Shadow" Color="#000000"/>
    <SolidColorBrush x:Key="Brush.ScrollTrack" Color="#12171F"/>
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#5A657A"/>

    <SolidColorBrush x:Key="Brush.StatusAmareloForeground" Color="#353935"/>
    <SolidColorBrush x:Key="Brush.StatusAmareloSelectedForeground" Color="#353935"/>

    <!-- Neutraliza seleção padrão do Windows (fundo claro) no tema escuro. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#C5CEDC"/>

</ResourceDictionary>
