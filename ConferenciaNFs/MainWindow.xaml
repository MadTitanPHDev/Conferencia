<Window x:Class="ConferenciaNFs.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ConferenciaNFs.Models"
        xmlns:controls="clr-namespace:ConferenciaNFs.Controls"
        Title="Conferencia de Notas Fiscais"
        Height="820"
        Width="1280"
        MinHeight="560"
        MinWidth="760"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{DynamicResource Brush.Background}"
        FontFamily="{StaticResource Font.Primary}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="180" MaxWidth="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Width="220"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,1,0">
            <Grid Margin="18,24,18,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <Border Background="#0B0B0B"
                            CornerRadius="14"
                            Padding="10,12"
                            Margin="0,0,0,12">
                        <Image Source="pack://application:,,,/Assets/logo-sidebar.png"
                               Stretch="Uniform"
                               MaxHeight="96"
                               HorizontalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="Controle diario de notas"
                               Style="{StaticResource PageSubtitleStyle}"
                               Margin="2,0,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="MENU"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="6,0,0,8"/>
                    <Button Content="  Dashboard"
                            Style="{StaticResource SidebarNavButtonActiveStyle}"
                            IsEnabled="False"
                            Margin="0,0,0,4"/>
                    <Button Content="  Gerenciar lojas"
                            Command="{Binding GerenciarLojasCommand}"
                            Style="{StaticResource SidebarNavButtonStyle}"
                            Margin="0,0,0,4"/>
                    <Button Content="  Pesquisar nota"
                            Command="{Binding PesquisarNotaCommand}"
                            Style="{StaticResource SidebarNavButtonStyle}"/>
                </StackPanel>

                <Border Grid.Row="3"
                        Background="{DynamicResource Brush.SurfaceMuted}"
                        CornerRadius="12"
                        Padding="14"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Dica rapida"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Foreground="{DynamicResource Brush.TextPrimary}"/>
                        <TextBlock Text="Importe a planilha do dia, escolha a data no calendario e abra a loja para conferir."
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="24,22,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Dashboard"
                               Style="{StaticResource PageTitleStyle}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding MensagemStatus}"
                               Style="{StaticResource PageSubtitleStyle}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <WrapPanel Grid.Row="1"
                           HorizontalAlignment="Left">
                    <controls:ThemeToggle Margin="0,0,8,8"/>
                    <controls:PinWindowToggle Margin="0,0,8,8"/>
                    <Button Content="Importar CSV"
                            Command="{Binding ImportarCsvCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,8,8"/>
                    <Button Content="Exportar tudo"
                            Command="{Binding ExportarTodasCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,8"/>
                    <Button Content="Migrar SQLite"
                            Command="{Binding MigrarSqliteCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,8"
                            ToolTip="Copia database.db antigo para o PostgreSQL (uso unico)"/>
                    <Button Content="Atualizar"
                            Command="{Binding AtualizarCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,0,8"/>
                </WrapPanel>
            </Grid>

            <Border Grid.Row="1"
                    Style="{StaticResource SurfaceCardStyle}"
                    Padding="10,8"
                    Margin="0,0,0,12">
                <WrapPanel VerticalAlignment="Center">
                    <Border Background="{DynamicResource Brush.AccentSoft}"
                            CornerRadius="8"
                            Padding="8,6"
                            Margin="0,4,12,4"
                            VerticalAlignment="Center">
                        <TextBlock Text="Dia"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Foreground="{DynamicResource Brush.Accent}"/>
                    </Border>

                    <Viewbox MaxHeight="132"
                             MaxWidth="196"
                             Stretch="Uniform"
                             Margin="0,4,16,4"
                             VerticalAlignment="Center">
                        <Calendar SelectedDate="{Binding DataSelecionada, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Language="pt-BR"
                                  Style="{StaticResource ModernCalendarCompactStyle}"/>
                    </Viewbox>

                    <StackPanel MinWidth="180"
                                MaxWidth="420"
                                Margin="0,4,0,4"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding DataSelecionadaTexto}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="Selecione o dia da conferencia e importe o CSV. Todas as notas da planilha ficam neste dia."
                                   Style="{StaticResource PageSubtitleStyle}"
                                   FontSize="12"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </WrapPanel>
            </Border>

            <Border Grid.Row="2"
                    Style="{StaticResource EmptyStateBorderStyle}"
                    Visibility="{Binding EstaVazio, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="88" Height="88"
                            CornerRadius="20"
                            Background="#0B0B0B"
                            Padding="10"
                            Margin="0,0,0,16">
                        <Image Source="pack://application:,,,/Assets/logo-mark.png"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="Nenhuma loja para este dia"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.TextPrimary}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Importe a planilha do dia ou selecione outra data."
                               Style="{StaticResource PageSubtitleStyle}"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding EstaVazio, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding Lojas}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ColumnsFromWidthConverter}}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:LojaPendencia}">
                            <Button Command="{Binding DataContext.AbrirConferenciaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource LojaCardButtonStyle}"
                                    Margin="0,0,12,12">
                                <Border Style="{StaticResource LojaCardBorderStyle}" MinHeight="124">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                            <Border HorizontalAlignment="Left"
                                                    Background="{DynamicResource Brush.AccentSoft}"
                                                    CornerRadius="8"
                                                    Padding="8,4"
                                                    Visibility="{Binding PossuiOrdemCadastrada, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{Binding NumeroOrdem, StringFormat='Loja {0}'}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.Accent}"/>
                                            </Border>

                                            <Border HorizontalAlignment="Right"
                                                    Background="{DynamicResource Brush.DangerSoft}"
                                                    CornerRadius="20"
                                                    Padding="10,5"
                                                    MinWidth="32"
                                                    Visibility="{Binding TemPendencias, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{Binding Pendencias}"
                                                           Foreground="{DynamicResource Brush.Danger}"
                                                           FontWeight="Bold"
                                                           FontSize="13"
                                                           HorizontalAlignment="Center"/>
                                            </Border>

                                            <Border HorizontalAlignment="Right"
                                                    Background="{DynamicResource Brush.AccentSoft}"
                                                    CornerRadius="20"
                                                    Padding="10,5"
                                                    Visibility="{Binding TemPendencias, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                <TextBlock Text="OK"
                                                           Foreground="{DynamicResource Brush.Accent}"
                                                           FontWeight="Bold"
                                                           FontSize="12"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>

                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding TituloCard}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,0,6"/>

                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding TextoStatusCard}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource Brush.TextSecondary}"/>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="{DynamicResource Brush.Overlay}"
                    CornerRadius="14"
                    Visibility="{Binding IsCarregando, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Carregando..."
                           FontSize="16"
                           Foreground="{DynamicResource Brush.TextPrimary}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <TextBlock Grid.Row="3"
                       Margin="0,14,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       TextWrapping="Wrap"
                       Text="Todas as lojas do dia ficam disponiveis. O numero vermelho indica notas em branco ou amarelo."/>
        </Grid>
    </Grid>
</Window>
