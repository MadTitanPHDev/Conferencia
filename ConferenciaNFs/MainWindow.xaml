<Window x:Class="ConferenciaNFs.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ConferenciaNFs.Models"
        xmlns:controls="clr-namespace:ConferenciaNFs.Controls"
        Title="Conferencia de Notas Fiscais"
        Height="820"
        Width="1280"
        MinHeight="560"
        MinWidth="760"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{DynamicResource Brush.Background}"
        FontFamily="{StaticResource Font.Primary}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="180" MaxWidth="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Width="220"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,1,0">
            <Grid Margin="18,24,18,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <Border Background="#0B0B0B"
                            CornerRadius="14"
                            Padding="10,12"
                            Margin="0,0,0,12">
                        <Image Source="pack://application:,,,/Assets/logo-sidebar.png"
                               Stretch="Uniform"
                               MaxHeight="96"
                               HorizontalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="Controle diario de notas"
                               Style="{StaticResource PageSubtitleStyle}"
                               Margin="2,0,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="MENU"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="6,0,0,8"/>
                    <Button Content="  Conferencia"
                            Style="{StaticResource SidebarNavButtonActiveStyle}"
                            IsEnabled="False"
                            Margin="0,0,0,4"/>
                    <Button Content="  Gerenciar lojas"
                            Command="{Binding GerenciarLojasCommand}"
                            Style="{StaticResource SidebarNavButtonStyle}"
                            Margin="0,0,0,4"/>
                    <Button Content="  Distribuidoras"
                            Command="{Binding GerenciarDistribuidorasCommand}"
                            Style="{StaticResource SidebarNavButtonStyle}"
                            Margin="0,0,0,4"/>
                    <Button Content="  Devolucoes"
                            Command="{Binding DevolucoesCommand}"
                            Style="{StaticResource SidebarNavButtonStyle}"
                            Margin="0,0,0,4"/>
                    <Button Content="  Pesquisar nota"
                            Command="{Binding PesquisarNotaCommand}"
                            Style="{StaticResource SidebarNavButtonStyle}"
                            Margin="0,0,0,4"/>
                    <Button Content="  Pesquisar produto"
                            Command="{Binding PesquisarProdutoCommand}"
                            Style="{StaticResource SidebarNavButtonStyle}"/>
                </StackPanel>

                <Border Grid.Row="3"
                        Background="{DynamicResource Brush.SurfaceMuted}"
                        CornerRadius="12"
                        Padding="14"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Dica rapida"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Foreground="{DynamicResource Brush.TextPrimary}"/>
                        <TextBlock Text="Escolha o intervalo (de / ate). As notas entram pelo VSM; o CSV continua como reserva na data final."
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid Margin="24,22,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding TituloPagina}"
                               Style="{StaticResource PageTitleStyle}"
                               FontSize="22"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding MensagemStatus}"
                               Style="{StaticResource PageSubtitleStyle}"
                               Margin="0,6,0,12"
                               TextWrapping="Wrap"/>
                    <WrapPanel HorizontalAlignment="Left">
                        <controls:ThemeToggle Margin="0,0,8,0"/>
                        <controls:PinWindowToggle Margin="0,0,8,0"/>
                        <Button Content="Sincronizar VSM"
                                Command="{Binding SincronizarVsmCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,8,0"
                                Visibility="{Binding SyncVsmDisponivel, Converter={StaticResource BoolToVisibilityConverter}}"
                                ToolTip="Busca as notas de cada dia do intervalo no VSM e grava no banco da conferencia."/>
                        <Button Content="Importar CSV"
                                Command="{Binding ImportarCsvCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,8,0"
                                ToolTip="Alternativa se o VSM nao estiver disponivel. As linhas vao para a data final do intervalo."/>
                        <Button Content="Exportar tudo"
                                Command="{Binding ExportarTodasCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,8,0"/>
                        <Button Content="Atualizar"
                                Command="{Binding AtualizarCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"/>
                    </WrapPanel>
                </StackPanel>

                <Border Grid.Column="1"
                        Style="{StaticResource SurfaceCardStyle}"
                        Padding="12,10"
                        Margin="0,0,10,0"
                        VerticalAlignment="Top"
                        MinWidth="168">
                    <StackPanel>
                        <TextBlock Text="De"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding DataInicio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Language="pt-BR"
                                    Width="148"
                                    Margin="0,0,0,8"/>
                        <TextBlock Text="Ate"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding DataFim, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Language="pt-BR"
                                    Width="148"/>
                    </StackPanel>
                </Border>

                <Button x:Name="BtnMenuAvancado"
                        Grid.Column="2"
                        VerticalAlignment="Top"
                        Content="☰"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="42"
                        Height="42"
                        FontSize="18"
                        Padding="0"
                        Click="ToggleMenuAvancado_Click"
                        ToolTip="Ferramentas avancadas"/>
            </Grid>

            <Border Grid.Row="1"
                    Style="{StaticResource EmptyStateBorderStyle}"
                    Visibility="{Binding EstaVazio, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="88" Height="88"
                            CornerRadius="20"
                            Background="#0B0B0B"
                            Padding="10"
                            Margin="0,0,0,16">
                        <Image Source="pack://application:,,,/Assets/logo-mark.png"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="Nenhuma loja neste intervalo"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.TextPrimary}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Sincronize o VSM, importe um CSV ou ajuste as datas."
                               Style="{StaticResource PageSubtitleStyle}"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding EstaVazio, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding Lojas}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ColumnsFromWidthConverter}}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:LojaPendencia}">
                            <Button Command="{Binding DataContext.AbrirConferenciaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource LojaCardButtonStyle}"
                                    Margin="0,0,12,12">
                                <Border Style="{StaticResource LojaCardBorderStyle}" MinHeight="124">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                            <Border HorizontalAlignment="Left"
                                                    Background="{DynamicResource Brush.AccentSoft}"
                                                    CornerRadius="8"
                                                    Padding="8,4"
                                                    Visibility="{Binding PossuiOrdemCadastrada, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{Binding NumeroOrdem, StringFormat='Loja {0}'}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.Accent}"/>
                                            </Border>

                                            <Border HorizontalAlignment="Right"
                                                    Background="{DynamicResource Brush.DangerSoft}"
                                                    CornerRadius="20"
                                                    Padding="10,5"
                                                    MinWidth="32"
                                                    Visibility="{Binding TemPendencias, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{Binding Pendencias}"
                                                           Foreground="{DynamicResource Brush.Danger}"
                                                           FontWeight="Bold"
                                                           FontSize="13"
                                                           HorizontalAlignment="Center"/>
                                            </Border>

                                            <Border HorizontalAlignment="Right"
                                                    Background="{DynamicResource Brush.AccentSoft}"
                                                    CornerRadius="20"
                                                    Padding="10,5"
                                                    Visibility="{Binding TemPendencias, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                <TextBlock Text="OK"
                                                           Foreground="{DynamicResource Brush.Accent}"
                                                           FontWeight="Bold"
                                                           FontSize="12"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>

                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding TituloCard}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,0,6"/>

                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding TextoStatusCard}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource Brush.TextSecondary}"/>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="1"
                    Background="{DynamicResource Brush.Overlay}"
                    CornerRadius="14"
                    Visibility="{Binding IsCarregando, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Carregando..."
                           FontSize="16"
                           Foreground="{DynamicResource Brush.TextPrimary}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <TextBlock Grid.Row="2"
                       Margin="0,14,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       TextWrapping="Wrap"
                       Text="Todas as lojas do dia ficam disponiveis. O numero vermelho indica notas em branco ou amarelo."/>
            </Grid>

            <Border x:Name="MenuAvancadoOverlay"
                    Background="#66000000"
                    Visibility="Collapsed"
                    Panel.ZIndex="20"
                    MouseDown="FecharMenuAvancado_Click"/>

            <Border x:Name="MenuAvancadoDrawer"
                    HorizontalAlignment="Right"
                    Width="300"
                    Visibility="Collapsed"
                    Panel.ZIndex="30"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,18">
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="FERRAMENTAS"
                                       Style="{StaticResource SectionTitleStyle}"
                                       VerticalAlignment="Center"/>
                            <Button Content="✕"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="8,4"
                                    FontSize="12"
                                    Click="FecharMenuAvancado_Click"/>
                        </Grid>

                        <TextBlock Text="Heranca de status"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   Margin="0,0,0,8"/>
                        <CheckBox Content="Herdar status na importacao"
                                  IsChecked="{Binding HerancaStatusImportacao, Mode=TwoWay}"
                                  FontSize="12"
                                  Margin="0,0,0,12"
                                  ToolTip="Novas notas herdam status do historico (loja + nota + CNPJ ou chave NFe). Sem historico, emissao anterior ao ultimo dia conferido entra como Laranja (outro dia)."/>
                        <Button Content="Recalcular herdados do dia"
                                Command="{Binding RecalcularHerancaDiaCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="12,8"
                                FontSize="12"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,20"
                                ToolTip="Aplica heranca no dia selecionado: historico da mesma NF e notas em branco emitidas antes do ultimo dia ja conferido."/>

                        <TextBlock Text="Migracao"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   Margin="0,0,0,8"/>
                        <Button Content="Migrar SQLite"
                                Command="{Binding MigrarSqliteCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="12,8"
                                FontSize="12"
                                HorizontalAlignment="Stretch"
                                ToolTip="Copia database.db antigo para o PostgreSQL (uso unico)"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

        </Grid>
    </Grid>
</Window>
