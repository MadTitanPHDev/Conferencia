<UserControl x:Class="ConferenciaNFs.Controls.PinWindowToggle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:ConferenciaNFs.Infrastructure">
    <ToggleButton IsChecked="{Binding Source={x:Static infra:WindowPinService.Instance}, Path=IsPinned, Mode=TwoWay}"
                  Style="{StaticResource PinToggleButtonStyle}"
                  ToolTip="{Binding Source={x:Static infra:WindowPinService.Instance}, Path=DicaBotao}">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE7B8;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="14"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Source={x:Static infra:WindowPinService.Instance}, Path=TextoBotao}"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </ToggleButton>
</UserControl>
