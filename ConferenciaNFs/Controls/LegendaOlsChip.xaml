<UserControl x:Class="ConferenciaNFs.Controls.LegendaOlsChip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Raiz"
             MouseEnter="AoEntrar"
             MouseLeave="AoSair">
    <Grid>
        <TextBlock Text="{Binding Bloco.Titulo, ElementName=Raiz}"
                   FontSize="11"
                   Foreground="{DynamicResource Brush.TextSecondary}"
                   Cursor="Hand"
                   VerticalAlignment="Center"
                   Margin="0,2,12,2"/>
        <Popup x:Name="Quadro"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=Raiz}"
               AllowsTransparency="True"
               StaysOpen="True"
               PopupAnimation="Fade">
            <Border Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,10"
                    Margin="0,4,0,0"
                    MouseEnter="AoEntrar"
                    MouseLeave="AoSair">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.18" Color="#000000"/>
                </Border.Effect>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              MaxHeight="420">
                    <ItemsControl ItemsSource="{Binding Bloco.Colunas, ElementName=Raiz}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="190" Margin="0,0,14,0">
                                    <TextBlock Text="{Binding Pessoa}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                               Margin="0,0,0,6"/>
                                    <ItemsControl ItemsSource="{Binding Itens}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,0,0,2"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</UserControl>
