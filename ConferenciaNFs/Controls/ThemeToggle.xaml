<UserControl x:Class="ConferenciaNFs.Controls.ThemeToggle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:ConferenciaNFs.Infrastructure">
    <ToggleButton IsChecked="{Binding Source={x:Static infra:ThemeService.Instance}, Path=IsDarkTheme, Mode=TwoWay}"
                  Style="{StaticResource ThemeToggleButtonStyle}"
                  ToolTip="{Binding Source={x:Static infra:ThemeService.Instance}, Path=DicaBotao}">
        <StackPanel Orientation="Horizontal">
            <TextBlock FontFamily="Segoe MDL2 Assets"
                       FontSize="14"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="&#xE708;"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Source={x:Static infra:ThemeService.Instance}, Path=IsDarkTheme}" Value="True">
                                <Setter Property="Text" Value="&#xE706;"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding Source={x:Static infra:ThemeService.Instance}, Path=TextoBotao}"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </ToggleButton>
</UserControl>
