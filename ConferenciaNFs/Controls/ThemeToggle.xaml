<UserControl x:Class="ConferenciaNFs.Controls.ThemeToggle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:ConferenciaNFs.Infrastructure">
    <ToggleButton IsChecked="{Binding Source={x:Static infra:ThemeService.Instance}, Path=IsDarkTheme, Mode=TwoWay}"
                  Style="{StaticResource ThemeToggleButtonStyle}"
                  ToolTip="{Binding Source={x:Static infra:ThemeService.Instance}, Path=DicaBotao}"/>
</UserControl>
