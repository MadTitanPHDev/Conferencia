<Window x:Class="ConferenciaNFs.Views.GerenciarPessoasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pessoas"
        Height="520"
        Width="560"
        MinHeight="400"
        MinWidth="420"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}"
        FontFamily="{StaticResource Font.Primary}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Pessoas"
                       Style="{StaticResource PageTitleStyle}"
                       FontSize="22"/>
            <TextBlock Text="{Binding Mensagem}"
                       Style="{StaticResource PageSubtitleStyle}"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right"
                    Content="Adicionar"
                    Command="{Binding AdicionarCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Padding="12,8"
                    Margin="8,0,0,0"/>
            <TextBox Text="{Binding NovoNome, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource ModernTextBoxStyle}"
                     Padding="10,8"
                     Tag="Nome"/>
        </DockPanel>

        <Border Grid.Row="2" Style="{StaticResource SurfaceCardStyle}" Padding="8" Margin="0,0,0,12">
            <DataGrid ItemsSource="{Binding Pessoas}"
                      SelectedItem="{Binding Selecionada, Mode=TwoWay}"
                      Style="{StaticResource ModernDataGridStyle}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*"/>
                    <DataGridTextColumn Header="Ativo"
                                        Binding="{Binding Ativo, Converter={StaticResource BoolToSimNaoConverter}}"
                                        Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <DockPanel Grid.Row="3">
            <Button DockPanel.Dock="Right"
                    Content="Fechar"
                    Click="Fechar_Click"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="12,7"/>
            <Button Content="Desativar selecionada"
                    Command="{Binding DesativarCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="12,7"
                    HorizontalAlignment="Left"/>
        </DockPanel>
    </Grid>
</Window>
