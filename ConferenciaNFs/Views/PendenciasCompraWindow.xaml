<UserControl x:Class="ConferenciaNFs.Views.PendenciasCompraWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Brush.Background}"
             FontFamily="{StaticResource Font.Primary}">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right"
                    Content="Atualizar"
                    Command="{Binding AtualizarCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="12,6"
                    VerticalAlignment="Top"/>
            <StackPanel>
                <TextBlock Text="Divergencias enviadas"
                           Style="{StaticResource PageTitleStyle}"
                           FontSize="16"/>
                <TextBlock Text="{Binding Mensagem}"
                           Style="{StaticResource PageSubtitleStyle}"
                           FontSize="12"
                           Margin="0,2,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource SurfaceCardStyle}" Padding="4" Margin="0,0,0,8">
            <DataGrid ItemsSource="{Binding Pendencias}"
                      SelectedItem="{Binding Selecionada, Mode=TwoWay}"
                      MouseDoubleClick="GrdPendencias_MouseDoubleClick"
                      PreviewKeyDown="GrdPendencias_PreviewKeyDown"
                      Style="{StaticResource ModernDataGridStyle}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PlanilhaDevolucao}" Value="Verde">
                                <Setter Property="Background" Value="#92D050"/>
                                <Setter Property="Foreground" Value="#1B5E20"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding PlanilhaDevolucao}" Value="Amarelo">
                                <Setter Property="Background" Value="#FFFF00"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.StatusAmareloForeground}"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding PlanilhaDevolucao}" Value="Verde"/>
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="#6FBF3A"/>
                                <Setter Property="Foreground" Value="#102910"/>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding PlanilhaDevolucao}" Value="Amarelo"/>
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="#E6E600"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.StatusAmareloSelectedForeground}"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PlanilhaDevolucao}" Value="Verde">
                                <Setter Property="Foreground" Value="#1B5E20"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding PlanilhaDevolucao}" Value="Amarelo">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.StatusAmareloForeground}"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding PlanilhaDevolucao}" Value="Verde"/>
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="#6FBF3A"/>
                                <Setter Property="Foreground" Value="#102910"/>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding PlanilhaDevolucao}" Value="Amarelo"/>
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="#E6E600"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.StatusAmareloSelectedForeground}"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Enviado por" Binding="{Binding EnviadoPorNome}" Width="120"/>
                    <DataGridTextColumn Header="Para" Binding="{Binding PessoaNome}" Width="120"/>
                    <DataGridTextColumn Header="Loja" Binding="{Binding ApelidoLoja}" Width="90"/>
                    <DataGridTextColumn Header="Nota" Binding="{Binding NumNota}" Width="90"/>
                    <DataGridTextColumn Header="Dia" Binding="{Binding DiaConferencia}" Width="90"/>
                    <DataGridTextColumn Header="Distribuidora" Binding="{Binding NomeDistribuidora}" Width="*"/>
                    <DataGridTextColumn Header="VSM" Binding="{Binding SituacaoVsmRotulo}" Width="110"/>
                    <DataGridTextColumn Header="Situacao" Binding="{Binding StatusPendencia}" Width="90"/>
                    <DataGridTextColumn Header="Observacao" Binding="{Binding Observacao}" Width="160"/>
                    <DataGridTextColumn Header="Enviada em" Binding="{Binding CriadaEm}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource SurfaceCardStyle}" Padding="12,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Margin="16,0,0,0">
                    <Button Content="Copiar numero"
                            Command="{Binding CopiarNumeroCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="12,7"
                            Margin="0,0,0,8"
                            Visibility="{Binding DevolvidasPeloComprador, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Button Content="Ver itens"
                        Command="{Binding AbrirItensCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="12,7"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        ToolTip="Abre a pre-nota, onde o comprador responde."/>
                </StackPanel>
                <StackPanel>
                    <CheckBox Content="Mostrar concluidas"
                              IsChecked="{Binding MostrarConcluidas}"
                              Margin="0,0,0,8"/>
                    <CheckBox Content="Devolvidas pelo comprador"
                              IsChecked="{Binding DevolvidasPeloComprador}"
                              Margin="0,0,0,8"
                              Visibility="{Binding VerEquipe, Converter={StaticResource BoolToVisibilityConverter}}"
                              ToolTip="Lista o que o comprador mandou devolver. Verde ja esta na planilha. Amarelo ainda falta lancar."/>
                    <TextBlock Text="ITENS"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding TextoItensSelecionada}"
                               TextWrapping="Wrap"
                               FontSize="13"
                               Foreground="{DynamicResource Brush.TextPrimary}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
