<UserControl x:Class="ConferenciaNFs.Views.PendenciasCompraWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Brush.Background}"
             FontFamily="{StaticResource Font.Primary}">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right"
                    Content="Atualizar"
                    Command="{Binding AtualizarCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="12,6"
                    VerticalAlignment="Top"/>
            <StackPanel>
                <TextBlock Text="Divergencias enviadas"
                           Style="{StaticResource PageTitleStyle}"
                           FontSize="16"/>
                <TextBlock Text="{Binding Mensagem}"
                           Style="{StaticResource PageSubtitleStyle}"
                           FontSize="12"
                           Margin="0,2,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource SurfaceCardStyle}" Padding="4" Margin="0,0,0,8">
            <DataGrid ItemsSource="{Binding Pendencias}"
                      SelectedItem="{Binding Selecionada, Mode=TwoWay}"
                      MouseDoubleClick="GrdPendencias_MouseDoubleClick"
                      Style="{StaticResource ModernDataGridStyle}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Enviado por" Binding="{Binding EnviadoPorNome}" Width="120"/>
                    <DataGridTextColumn Header="Para" Binding="{Binding PessoaNome}" Width="120"/>
                    <DataGridTextColumn Header="Loja" Binding="{Binding ApelidoLoja}" Width="90"/>
                    <DataGridTextColumn Header="Nota" Binding="{Binding NumNota}" Width="90"/>
                    <DataGridTextColumn Header="Dia" Binding="{Binding DiaConferencia}" Width="90"/>
                    <DataGridTextColumn Header="Fornecedor" Binding="{Binding NomeForn}" Width="*"/>
                    <DataGridTextColumn Header="Situacao" Binding="{Binding StatusPendencia}" Width="90"/>
                    <DataGridTextColumn Header="Observacao" Binding="{Binding Observacao}" Width="160"/>
                    <DataGridTextColumn Header="Enviada em" Binding="{Binding CriadaEm}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource SurfaceCardStyle}" Padding="12,10">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="Ver itens"
                        Command="{Binding AbrirItensCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="12,7"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        ToolTip="Abre a pre-nota, onde o comprador responde."/>
                <StackPanel>
                    <CheckBox Content="Mostrar concluidas"
                              IsChecked="{Binding MostrarConcluidas}"
                              Margin="0,0,0,8"/>
                    <TextBlock Text="ITENS"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding TextoItensSelecionada}"
                               TextWrapping="Wrap"
                               FontSize="13"
                               Foreground="{DynamicResource Brush.TextPrimary}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
