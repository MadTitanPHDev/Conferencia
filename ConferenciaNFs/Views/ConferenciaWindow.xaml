<Window x:Class="ConferenciaNFs.Views.ConferenciaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ConferenciaNFs.Controls"
        Title="Conferencia"
        Height="760"
        Width="1180"
        MinHeight="520"
        MinWidth="720"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}"
        FontFamily="{StaticResource Font.Primary}">

    <Window.InputBindings>
        <KeyBinding Key="D0" Command="{Binding DefinirPendenteCommand}"/>
        <KeyBinding Key="NumPad0" Command="{Binding DefinirPendenteCommand}"/>
        <KeyBinding Key="D1" Command="{Binding DefinirVerdeCommand}"/>
        <KeyBinding Key="F1" Command="{Binding DefinirVerdeCommand}"/>
        <KeyBinding Key="D2" Command="{Binding DefinirAmareloCommand}"/>
        <KeyBinding Key="F2" Command="{Binding DefinirAmareloCommand}"/>
        <KeyBinding Key="D3" Command="{Binding DefinirVermelhoCommand}"/>
        <KeyBinding Key="F3" Command="{Binding DefinirVermelhoCommand}"/>
        <KeyBinding Key="D4" Command="{Binding DefinirLaranjaCommand}"/>
        <KeyBinding Key="F4" Command="{Binding DefinirLaranjaCommand}"/>
        <KeyBinding Key="D5" Command="{Binding DefinirAzulCommand}"/>
        <KeyBinding Key="NumPad5" Command="{Binding DefinirAzulCommand}"/>
        <KeyBinding Key="F8" Command="{Binding DefinirAzulCommand}"/>
        <KeyBinding Key="F5" Command="{Binding DefinirObservacaoPbmCommand}"/>
        <KeyBinding Key="F6" Command="{Binding DefinirObservacaoUsoConsumoCommand}"/>
        <KeyBinding Key="F7" Command="{Binding DefinirObservacaoConvenienciaCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="S" Command="{Binding SalvarObservacaoCommand}"/>
    </Window.InputBindings>

    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,6">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Left"
                            Width="36" Height="36"
                            CornerRadius="8"
                            Background="#0B0B0B"
                            Padding="4"
                            Margin="0,0,10,0"
                            VerticalAlignment="Top">
                        <Image Source="pack://application:,,,/Assets/logo-mark.png"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="{Binding TituloConferencia}"
                                   Style="{StaticResource PageTitleStyle}"
                                   FontSize="20"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding MensagemStatus}"
                                   Style="{StaticResource PageSubtitleStyle}"
                                   Margin="0,2,0,0"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>

            <WrapPanel Grid.Row="1" HorizontalAlignment="Left">
                <controls:ThemeToggle Margin="0,0,6,4"/>
                <controls:PinWindowToggle Margin="0,0,6,4"/>
                <Button Content="Exportar"
                        Command="{Binding ExportarConferenciaCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Padding="12,6"
                        FontSize="12"
                        Margin="0,0,6,4"/>
                <Button Content="Fechar"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="12,6"
                        FontSize="12"
                        Click="Fechar_Click"
                        Margin="0,0,0,4"/>
            </WrapPanel>
        </Grid>

        <Border Grid.Row="1"
                Style="{StaticResource SurfaceCardStyle}"
                Padding="10,6"
                Margin="0,0,0,8">
            <DockPanel LastChildFill="False">
                <TextBlock Text="STATUS"
                           Style="{StaticResource SectionTitleStyle}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           DockPanel.Dock="Left"/>
                <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Button Content="Nao conferido"
                            Command="{Binding DefinirPendenteCommand}"
                            Style="{StaticResource StatusButtonStyle}"
                            Tag="Pendente"
                            ToolTip="0"
                            Margin="0,2,6,2"/>
                    <Button Content="Correta"
                            Command="{Binding DefinirVerdeCommand}"
                            Style="{StaticResource StatusButtonStyle}"
                            Tag="Verde"
                            ToolTip="1 / F1"
                            Margin="0,2,6,2"/>
                    <Button Content="Advertencia"
                            Command="{Binding DefinirAmareloCommand}"
                            Style="{StaticResource StatusButtonStyle}"
                            Tag="Amarelo"
                            ToolTip="2 / F2"
                            Margin="0,2,6,2"/>
                    <Button Content="Devolvida"
                            Command="{Binding DefinirVermelhoCommand}"
                            Style="{StaticResource StatusButtonStyle}"
                            Tag="Vermelho"
                            ToolTip="3 / F3"
                            Margin="0,2,6,2"/>
                    <Button Content="Outro dia"
                            Command="{Binding DefinirLaranjaCommand}"
                            Style="{StaticResource StatusButtonStyle}"
                            Tag="Laranja"
                            ToolTip="4 / F4"
                            Margin="0,2,6,2"/>
                    <Button Content="Absorver"
                            Command="{Binding DefinirAzulCommand}"
                            Style="{StaticResource StatusButtonStyle}"
                            Tag="Azul"
                            ToolTip="5 / F8"
                            Margin="0,2,0,2"/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource SurfaceCardStyle}"
                Padding="4">
            <DataGrid x:Name="GrdNotas"
                      ItemsSource="{Binding Notas}"
                      SelectedItem="{Binding NotaSelecionada, Mode=TwoWay}"
                      Style="{StaticResource ModernDataGridStyle}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      RowHeaderWidth="0"
                      PreviewMouseRightButtonDown="GrdNotas_PreviewMouseRightButtonDown"
                      PreviewMouseWheel="GrdNotas_PreviewMouseWheel"
                      PreviewKeyDown="GrdNotas_PreviewKeyDown"
                      MouseDoubleClick="GrdNotas_MouseDoubleClick">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Loja" Binding="{Binding ApelidoLoja}" Width="100"/>
                    <DataGridTextColumn Header="Nota" Binding="{Binding NumNota}" Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Fornecedor" Binding="{Binding NomeForn}" Width="*" MinWidth="140"/>
                    <DataGridTextColumn Header="Valor" Binding="{Binding ValorNota, StringFormat='R$ {0:N2}'}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Observacao" Binding="{Binding Observacao}" Width="160" MinWidth="100"/>
                </DataGrid.Columns>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Setter Property="Background" Value="{DynamicResource Brush.RowDefault}"/>
                        <Setter Property="MinHeight" Value="30"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusConferencia}" Value="Verde">
                                <Setter Property="Background" Value="#92D050"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusConferencia}" Value="Amarelo">
                                <Setter Property="Background" Value="#FFFF00"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusConferencia}" Value="Vermelho">
                                <Setter Property="Background" Value="#FF0000"/>
                                <Setter Property="Foreground" Value="White"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusConferencia}" Value="Laranja">
                                <Setter Property="Background" Value="#FFC000"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusConferencia}" Value="Azul">
                                <Setter Property="Background" Value="#2F75B5"/>
                                <Setter Property="Foreground" Value="White"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Nao conferido (Branco)" InputGestureText="0" Command="{Binding DefinirPendenteCommand}"/>
                        <Separator/>
                        <MenuItem Header="Nota correta (Verde)" InputGestureText="1 / F1" Command="{Binding DefinirVerdeCommand}"/>
                        <MenuItem Header="Com advertencia (Amarelo)" InputGestureText="2 / F2" Command="{Binding DefinirAmareloCommand}"/>
                        <MenuItem Header="Nota devolvida (Vermelho)" InputGestureText="3 / F3" Command="{Binding DefinirVermelhoCommand}"/>
                        <MenuItem Header="Nota de outro dia (Laranja)" InputGestureText="4 / F4" Command="{Binding DefinirLaranjaCommand}"/>
                        <MenuItem Header="Absorver nota (Azul)" InputGestureText="5 / F8" Command="{Binding DefinirAzulCommand}"/>
                        <Separator/>
                        <MenuItem Header="Observacao: PBM" InputGestureText="F5" Command="{Binding DefinirObservacaoPbmCommand}"/>
                        <MenuItem Header="Observacao: USO E CONSUMO" InputGestureText="F6" Command="{Binding DefinirObservacaoUsoConsumoCommand}"/>
                        <MenuItem Header="Observacao: CONVENIENCIA" InputGestureText="F7" Command="{Binding DefinirObservacaoConvenienciaCommand}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>
        </Border>

        <Border Grid.Row="2"
                Background="{DynamicResource Brush.Overlay}"
                CornerRadius="14"
                Visibility="{Binding IsCarregando, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="Carregando..."
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="16"
                       Foreground="{DynamicResource Brush.TextPrimary}"/>
        </Border>

        <Border Grid.Row="3"
                Style="{StaticResource SurfaceCardStyle}"
                Padding="10,8"
                Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="OBSERVACAO"
                           Style="{StaticResource SectionTitleStyle}"
                           Margin="0,0,0,6"/>

                <TextBlock Grid.Row="0" Grid.Column="1"
                           Text="F5 PBM · F6 USO · F7 CONV · Ctrl+S salvar"
                           Style="{StaticResource PageSubtitleStyle}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>

                <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                         Text="{Binding ObservacaoTexto, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Padding="10,6"
                         Margin="0,0,0,6"/>

                <WrapPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                    <Button Content="PBM"
                            Command="{Binding DefinirObservacaoPbmCommand}"
                            Style="{StaticResource PillTagButtonStyle}"
                            Padding="10,4"
                            FontSize="11"
                            Margin="0,0,6,0"/>
                    <Button Content="USO E CONSUMO"
                            Command="{Binding DefinirObservacaoUsoConsumoCommand}"
                            Style="{StaticResource PillTagButtonStyle}"
                            Padding="10,4"
                            FontSize="11"
                            Margin="0,0,6,0"/>
                    <Button Content="CONVENIENCIA"
                            Command="{Binding DefinirObservacaoConvenienciaCommand}"
                            Style="{StaticResource PillTagButtonStyle}"
                            Padding="10,4"
                            FontSize="11"
                            Margin="0,0,6,0"/>
                    <Button Content="Salvar texto"
                            Command="{Binding SalvarObservacaoCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="12,5"
                            FontSize="12"
                            Margin="0,0,0,0"/>
                </WrapPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="4"
                   Margin="0,6,0,0"
                   FontSize="11"
                   Foreground="{DynamicResource Brush.TextSecondary}"
                   TextWrapping="Wrap"
                   Text="Scroll: troca nota · 0 Branco · 1/F1 Verde · 2/F2 Amarelo · 3/F3 Vermelho · 4/F4 Laranja · 5/F8 Absorver · clique direito"/>
    </Grid>
</Window>
