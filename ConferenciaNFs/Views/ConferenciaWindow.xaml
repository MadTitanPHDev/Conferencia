<UserControl x:Class="ConferenciaNFs.Views.ConferenciaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:ConferenciaNFs.ViewModels"
        Background="{DynamicResource Brush.Background}"
        FontFamily="{StaticResource Font.Primary}"
        Focusable="True">

    <UserControl.InputBindings>
        <KeyBinding Key="D0" Command="{Binding DefinirPendenteCommand}"/>
        <KeyBinding Key="D1" Command="{Binding DefinirVerdeCommand}"/>
        <KeyBinding Key="F1" Command="{Binding DefinirVerdeCommand}"/>
        <KeyBinding Key="D2" Command="{Binding DefinirAmareloCommand}"/>
        <KeyBinding Key="F2" Command="{Binding DefinirAmareloCommand}"/>
        <KeyBinding Key="D3" Command="{Binding DefinirVermelhoCommand}"/>
        <KeyBinding Key="F3" Command="{Binding DefinirVermelhoCommand}"/>
        <KeyBinding Key="D4" Command="{Binding DefinirLaranjaCommand}"/>
        <KeyBinding Key="F4" Command="{Binding DefinirLaranjaCommand}"/>
        <KeyBinding Key="D5" Command="{Binding DefinirAzulCommand}"/>
        <KeyBinding Key="F8" Command="{Binding DefinirAzulCommand}"/>
        <KeyBinding Key="F5" Command="{Binding DefinirObservacaoPbmCommand}"/>
        <KeyBinding Key="F6" Command="{Binding DefinirObservacaoUsoConsumoCommand}"/>
        <KeyBinding Key="F7" Command="{Binding DefinirObservacaoConvenienciaCommand}"/>
        <KeyBinding Key="F9" Command="{Binding DefinirObservacaoBonificacaoCommand}"/>
        <KeyBinding Key="F11" Command="{Binding DefinirObservacaoEncomendaCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="S" Command="{Binding SalvarObservacaoCommand}"/>
        <KeyBinding Key="F12" Command="{Binding AlternarDuploCliqueCommand}"/>
    </UserControl.InputBindings>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource SurfaceCardStyle}"
                Padding="8,6"
                Margin="0,0,0,4">
            <StackPanel>
                <DockPanel LastChildFill="True" Margin="0,0,0,4">
                    <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                        <ToggleButton IsChecked="{Binding DuploCliqueCopiaNumero, Mode=TwoWay}"
                                      Style="{StaticResource DuploCliqueSwitchStyle}"
                                      Margin="0,0,12,0"
                                      VerticalAlignment="Center"
                                      ToolTip="{Binding DicaDuploClique}"/>
                        <Button Content="Exportar"
                                Command="{Binding ExportarConferenciaCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="8,3"
                                FontSize="11"/>
                    </WrapPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding TituloConferencia}"
                                   Style="{StaticResource PageTitleStyle}"
                                   FontSize="14"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding MensagemStatus}"
                                   Style="{StaticResource PageSubtitleStyle}"
                                   Margin="0,1,0,0"
                                   FontSize="11"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>

                <WrapPanel Margin="0,0,0,2">
                    <Button Content="Não conferido"
                            Command="{Binding DefinirPendenteCommand}"
                            Style="{StaticResource StatusButtonStyle}"
                            Tag="Pendente"
                            ToolTip="0 — ainda não conferida"
                            Margin="0,2,4,2"/>
                    <Button Content="Correta"
                            Command="{Binding DefinirVerdeCommand}"
                            Style="{StaticResource StatusButtonStyle}"
                            Tag="Verde"
                            ToolTip="1 / F1 — nota ok"
                            Margin="0,2,4,2"/>
                    <Button Content="Falar com compras"
                            Command="{Binding DefinirAmareloCommand}"
                            Style="{StaticResource StatusButtonStyle}"
                            Tag="Amarelo"
                            ToolTip="2 / F2 — advertência / pendência de compras"
                            Margin="0,2,4,2"/>
                    <Button Content="Devolver"
                            Command="{Binding DefinirVermelhoCommand}"
                            Style="{StaticResource StatusButtonStyle}"
                            Tag="Vermelho"
                            ToolTip="3 / F3 — abre a pré-nota. Não é o mesmo que 'Devolvida ao dist.' na fila"
                            Margin="0,2,4,2"/>
                    <Button Content="Já vista"
                            Command="{Binding DefinirLaranjaCommand}"
                            Style="{StaticResource StatusButtonStyle}"
                            Tag="Laranja"
                            ToolTip="4 / F4 — mesma NF já conferida em outro dia"
                            Margin="0,2,4,2"/>
                    <Button Content="Absorver"
                            Command="{Binding DefinirAzulCommand}"
                            Style="{StaticResource StatusButtonStyle}"
                            Tag="Azul"
                            ToolTip="5 / F8 — absorver na loja (não é o Absorvido da fila de devoluções)"
                            Margin="0,2,0,2"/>
                </WrapPanel>

                <DockPanel LastChildFill="True" Margin="0,4,0,4">
                    <Button DockPanel.Dock="Right"
                            Content="Limpar"
                            Command="{Binding LimparBuscaNotaCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="8,3"
                            FontSize="11"
                            Margin="6,0,0,0"/>
                    <TextBox x:Name="TxtBuscaNota"
                             Text="{Binding TextoBuscaNota, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Padding="8,4"
                             ToolTip="Filtra as notas desta loja pelo número (zeros à esquerda não importam)."/>
                </DockPanel>

                <WrapPanel>
                    <ItemsControl ItemsSource="{Binding FiltrosStatus}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:StatusFiltroOpcao}">
                                <CheckBox Content="{Binding Rotulo}"
                                          IsChecked="{Binding EstaAtivo}"
                                          Margin="0,2,10,2"
                                          FontSize="11"
                                          VerticalAlignment="Center"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <CheckBox Content="Só marcados"
                              IsChecked="{Binding ModoSomenteSelecionadas}"
                              FontSize="11"
                              Margin="8,2,10,2"
                              ToolTip="Oculta os status que não estão marcados no filtro."
                              VerticalAlignment="Center"/>
                    <Button Content="Todas"
                            Command="{Binding SelecionarTodosFiltrosCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="8,3"
                            FontSize="11"
                            Margin="0,2,6,2"/>
                    <Button Content="Nenhuma"
                            Command="{Binding LimparFiltrosCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="8,3"
                            FontSize="11"
                            Margin="0,2,0,2"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource SurfaceCardStyle}"
                Padding="4">
            <DataGrid x:Name="GrdNotas"
                      ItemsSource="{Binding NotasVisiveis}"
                      SelectedItem="{Binding NotaSelecionada, Mode=TwoWay}"
                      Style="{StaticResource ModernDataGridStyle}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      RowHeaderWidth="0"
                      PreviewMouseRightButtonDown="GrdNotas_PreviewMouseRightButtonDown"
                      PreviewMouseWheel="GrdNotas_PreviewMouseWheel"
                      PreviewKeyDown="GrdNotas_PreviewKeyDown"
                      MouseDoubleClick="GrdNotas_MouseDoubleClick">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Dia" Binding="{Binding DiaConferencia}" Width="82"/>
                    <DataGridTextColumn Header="Nota" Binding="{Binding NumNota}" Width="86">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Fornecedor" Binding="{Binding NomeForn}" Width="*" MinWidth="90"/>
                    <DataGridTextColumn Header="Valor" Binding="{Binding ValorNota, StringFormat='R$ {0:N2}'}" Width="88">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Observação" Binding="{Binding Observacao}" Width="120" MinWidth="70"/>
                </DataGrid.Columns>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Setter Property="Background" Value="{DynamicResource Brush.RowDefault}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                        <Setter Property="MinHeight" Value="30"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusConferencia}" Value="Verde">
                                <Setter Property="Background" Value="#92D050"/>
                                <Setter Property="Foreground" Value="#1B5E20"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusConferencia}" Value="Amarelo">
                                <Setter Property="Background" Value="#FFFF00"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.StatusAmareloForeground}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusConferencia}" Value="Vermelho">
                                <Setter Property="Background" Value="#FF0000"/>
                                <Setter Property="Foreground" Value="White"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusConferencia}" Value="Laranja">
                                <Setter Property="Background" Value="#FFC000"/>
                                <Setter Property="Foreground" Value="#7A4F00"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusConferencia}" Value="Azul">
                                <Setter Property="Background" Value="#2F75B5"/>
                                <Setter Property="Foreground" Value="White"/>
                            </DataTrigger>

                            <!-- Seleção: mantém contraste legível por status. -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding StatusConferencia}" Value="Pendente"/>
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="{DynamicResource Brush.SelectionBackground}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.SelectionForeground}"/>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding StatusConferencia}" Value="Verde"/>
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="#6FBF3A"/>
                                <Setter Property="Foreground" Value="#102910"/>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding StatusConferencia}" Value="Amarelo"/>
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="#E6E600"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.StatusAmareloSelectedForeground}"/>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding StatusConferencia}" Value="Vermelho"/>
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="#CC0000"/>
                                <Setter Property="Foreground" Value="White"/>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding StatusConferencia}" Value="Laranja"/>
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="#E0A800"/>
                                <Setter Property="Foreground" Value="#4A3000"/>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding StatusConferencia}" Value="Azul"/>
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="#245F94"/>
                                <Setter Property="Foreground" Value="White"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusConferencia}" Value="Verde">
                                <Setter Property="Foreground" Value="#1B5E20"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusConferencia}" Value="Amarelo">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.StatusAmareloForeground}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusConferencia}" Value="Vermelho">
                                <Setter Property="Foreground" Value="White"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusConferencia}" Value="Laranja">
                                <Setter Property="Foreground" Value="#7A4F00"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusConferencia}" Value="Azul">
                                <Setter Property="Foreground" Value="White"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding StatusConferencia}" Value="Pendente"/>
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="{DynamicResource Brush.SelectionBackground}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.SelectionForeground}"/>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding StatusConferencia}" Value="Verde"/>
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="#6FBF3A"/>
                                <Setter Property="Foreground" Value="#102910"/>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding StatusConferencia}" Value="Amarelo"/>
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="#E6E600"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.StatusAmareloSelectedForeground}"/>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding StatusConferencia}" Value="Vermelho"/>
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="#CC0000"/>
                                <Setter Property="Foreground" Value="White"/>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding StatusConferencia}" Value="Laranja"/>
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="#E0A800"/>
                                <Setter Property="Foreground" Value="#4A3000"/>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding StatusConferencia}" Value="Azul"/>
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="#245F94"/>
                                <Setter Property="Foreground" Value="White"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Abrir itens da nota"
                                  Command="{Binding AbrirItensCommand}"/>
                        <MenuItem Header="Copiar número da nota"
                                  InputGestureText="Ctrl+C"
                                  Command="{Binding CopiarNumeroNotaCommand}"/>
                        <Separator/>
                        <MenuItem Header="Não conferido (branco)" InputGestureText="0" Command="{Binding DefinirPendenteCommand}"/>
                        <Separator/>
                        <MenuItem Header="Nota correta (verde)" InputGestureText="1 / F1" Command="{Binding DefinirVerdeCommand}"/>
                        <MenuItem Header="Falar com compras (amarelo)" InputGestureText="2 / F2" Command="{Binding DefinirAmareloCommand}"/>
                        <MenuItem Header="Devolver (vermelho)" InputGestureText="3 / F3" Command="{Binding DefinirVermelhoCommand}"/>
                        <MenuItem Header="Já vista (laranja)" InputGestureText="4 / F4" Command="{Binding DefinirLaranjaCommand}"/>
                        <MenuItem Header="Absorver na loja (azul)" InputGestureText="5 / F8" Command="{Binding DefinirAzulCommand}"/>
                        <Separator/>
                        <MenuItem Header="Observação: PBM" InputGestureText="F5" Command="{Binding DefinirObservacaoPbmCommand}"/>
                        <MenuItem Header="Observação: USO E CONSUMO" InputGestureText="F6" Command="{Binding DefinirObservacaoUsoConsumoCommand}"/>
                        <MenuItem Header="Observação: CONVENIÊNCIA" InputGestureText="F7" Command="{Binding DefinirObservacaoConvenienciaCommand}"/>
                        <MenuItem Header="Observação: BONIFICAÇÃO" InputGestureText="F9" Command="{Binding DefinirObservacaoBonificacaoCommand}"/>
                        <MenuItem Header="Observação: ENCOMENDA" InputGestureText="F11" Command="{Binding DefinirObservacaoEncomendaCommand}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>
        </Border>

        <Border Grid.Row="1"
                Background="{DynamicResource Brush.Overlay}"
                CornerRadius="14"
                Visibility="{Binding IsCarregando, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="Carregando..."
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="16"
                       Foreground="{DynamicResource Brush.TextPrimary}"/>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource SurfaceCardStyle}"
                Padding="8,6"
                Margin="0,4,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="OBSERVAÇÃO"
                           Style="{StaticResource SectionTitleStyle}"
                           Margin="0,0,0,6"/>

                <TextBlock Grid.Row="0" Grid.Column="1"
                           Text="F5–F11 · Enter salva"
                           Style="{StaticResource PageSubtitleStyle}"
                           FontSize="10"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"/>

                <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                         Text="{Binding ObservacaoTexto, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Padding="8,4"
                         Margin="0,0,0,4"
                         AcceptsReturn="False">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SalvarObservacaoCommand}"/>
                        <KeyBinding Key="Return" Command="{Binding SalvarObservacaoCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <WrapPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                    <Button Content="PBM"
                            Command="{Binding DefinirObservacaoPbmCommand}"
                            Style="{StaticResource PillTagButtonStyle}"
                            Padding="10,4"
                            FontSize="11"
                            Margin="0,0,6,0"/>
                    <Button Content="USO E CONSUMO"
                            Command="{Binding DefinirObservacaoUsoConsumoCommand}"
                            Style="{StaticResource PillTagButtonStyle}"
                            Padding="10,4"
                            FontSize="11"
                            Margin="0,0,6,0"/>
                    <Button Content="CONVENIÊNCIA"
                            Command="{Binding DefinirObservacaoConvenienciaCommand}"
                            Style="{StaticResource PillTagButtonStyle}"
                            Padding="10,4"
                            FontSize="11"
                            Margin="0,0,6,0"/>
                    <Button Content="BONIFICAÇÃO"
                            Command="{Binding DefinirObservacaoBonificacaoCommand}"
                            Style="{StaticResource PillTagButtonStyle}"
                            Padding="10,4"
                            FontSize="11"
                            Margin="0,0,6,0"/>
                    <Button Content="ENCOMENDA"
                            Command="{Binding DefinirObservacaoEncomendaCommand}"
                            Style="{StaticResource PillTagButtonStyle}"
                            Padding="10,4"
                            FontSize="11"
                            Margin="0,0,6,0"/>
                    <Button Content="Salvar texto"
                            Command="{Binding SalvarObservacaoCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="12,5"
                            FontSize="12"
                            Margin="0,0,0,0"/>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
