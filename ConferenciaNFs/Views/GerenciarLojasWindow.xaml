<Window x:Class="ConferenciaNFs.Views.GerenciarLojasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ConferenciaNFs.Controls"
        Title="Gerenciar ordem das lojas"
        Height="680"
        Width="920"
        MinHeight="520"
        MinWidth="640"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}"
        FontFamily="{StaticResource Font.Primary}">

    <Window.Resources>
        <DataTemplate x:Key="EditarLojaTemplate">
            <StackPanel>
                <TextBlock Text="EDITAR LOJA"
                           Style="{StaticResource SectionTitleStyle}"
                           Margin="0,0,0,10"/>
                <TextBlock Text="Numero"
                           Style="{StaticResource PageSubtitleStyle}"
                           Margin="0,0,0,4"/>
                <TextBox Text="{Binding EditarNumeroOrdem, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Margin="0,0,0,10"/>
                <TextBlock Text="Nome exibido"
                           Style="{StaticResource PageSubtitleStyle}"
                           Margin="0,0,0,4"/>
                <TextBox Text="{Binding EditarNomeExibicao, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Margin="0,0,0,12"/>
                <WrapPanel>
                    <Button Content="Salvar edicao"
                            Command="{Binding SalvarEdicaoCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,8,0"/>
                    <Button Content="Remover"
                            Command="{Binding RemoverCadastroCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"/>
                </WrapPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="NovaLojaTemplate">
            <StackPanel>
                <TextBlock Text="NOVA LOJA"
                           Style="{StaticResource SectionTitleStyle}"
                           Margin="0,0,0,10"/>
                <TextBlock Text="Apelido do CSV"
                           Style="{StaticResource PageSubtitleStyle}"
                           Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding ApelidosSemOrdem}"
                          SelectedItem="{Binding ApelidoSemOrdemSelecionado}"
                          Style="{StaticResource ModernComboBoxStyle}"
                          Margin="0,0,0,10"/>
                <TextBlock Text="Numero"
                           Style="{StaticResource PageSubtitleStyle}"
                           Margin="0,0,0,4"/>
                <TextBox Text="{Binding NovoNumeroOrdem, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Margin="0,0,0,10"/>
                <TextBlock Text="Nome exibido"
                           Style="{StaticResource PageSubtitleStyle}"
                           Margin="0,0,0,4"/>
                <TextBox Text="{Binding NovoNomeExibicao, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Margin="0,0,0,12"/>
                <Button Content="Atribuir numero"
                        Command="{Binding SalvarNovaLojaCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Left"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="22,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="220"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="True">
            <Border DockPanel.Dock="Left"
                    Width="36" Height="36"
                    CornerRadius="8"
                    Background="{DynamicResource Brush.Brand}"
                    Padding="4"
                    Margin="0,0,10,0"
                    VerticalAlignment="Top">
                <Image Source="pack://application:,,,/Assets/logo-mark.png"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Top" Margin="12,0,0,0">
                <controls:ThemeToggle Margin="0,0,8,0"/>
                <controls:PinWindowToggle/>
            </WrapPanel>
            <StackPanel>
                <TextBlock Text="Ordem das lojas"
                           Style="{StaticResource PageTitleStyle}"
                           FontSize="24"
                           TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Mensagem}"
                           Style="{StaticResource PageSubtitleStyle}"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource SurfaceCardStyle}"
                    Padding="16,14"
                    VerticalAlignment="Top">
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource EditarLojaTemplate}"/>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource SurfaceCardStyle}"
                    Padding="16,14"
                    VerticalAlignment="Top">
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource NovaLojaTemplate}"/>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Style="{StaticResource SurfaceCardStyle}"
                Padding="8"
                Margin="0,0,0,12">
            <DataGrid ItemsSource="{Binding LojasCadastradas}"
                      SelectedItem="{Binding LojaSelecionada}"
                      Style="{StaticResource ModernDataGridStyle}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      HeadersVisibility="Column"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nº"
                                        Binding="{Binding NumeroOrdem}"
                                        Width="70"/>
                    <DataGridTextColumn Header="Apelido (CSV)"
                                        Binding="{Binding ApelidoLoja}"
                                        Width="180"/>
                    <DataGridTextColumn Header="Nome exibido"
                                        Binding="{Binding NomeExibicao}"
                                        Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <DockPanel Grid.Row="3">
            <WrapPanel HorizontalAlignment="Right">
                <Button Content="Atualizar"
                        Command="{Binding AtualizarCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0"/>
                <Button Content="Fechar"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Fechar_Click"/>
            </WrapPanel>
        </DockPanel>
    </Grid>
</Window>
