<UserControl x:Class="ConferenciaNFs.Views.DevolucoesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource Brush.Background}"
        FontFamily="{StaticResource Font.Primary}"
        Focusable="True">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecalho compacto -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                    <TextBlock Text="Devoluções"
                               Style="{StaticResource PageTitleStyle}"
                               FontSize="16"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Mensagem}"
                               Style="{StaticResource PageSubtitleStyle}"
                               FontSize="12"
                               Margin="0,2,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>

            <WrapPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right">
                <Button Content="Exportar Excel"
                        Command="{Binding ExportarExcelCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="12,6"
                        FontSize="12"
                        Margin="0,0,6,4"/>
                <Button Content="Atualizar"
                        Command="{Binding AtualizarCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="12,6"
                        FontSize="12"
                        Margin="0,0,0,4"/>
            </WrapPanel>
        </Grid>

        <!-- Periodo de rastreio compacto -->
        <Border Grid.Row="1"
                Style="{StaticResource SurfaceCardStyle}"
                Padding="10,6"
                Margin="0,0,0,8">
            <DockPanel LastChildFill="False">
                    <TextBlock Text="FILA"
                               Style="{StaticResource SectionTitleStyle}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               DockPanel.Dock="Left"/>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="A partir de (marcações novas)"
                               Style="{StaticResource PageSubtitleStyle}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,2,8,2"/>
                    <DatePicker SelectedDate="{Binding DataMinimaRastreio, UpdateSourceTrigger=PropertyChanged}"
                                Width="130"
                                Height="28"
                                Margin="0,2,10,2"
                                VerticalAlignment="Center"/>
                    <CheckBox Content="Remover pendências anteriores"
                              IsChecked="{Binding RemoverPendentesAnteriores, Mode=TwoWay}"
                              FontSize="12"
                              VerticalAlignment="Center"
                              Margin="0,2,10,2"
                              ToolTip="Pendências usam a data em que entrou na fila. Concluídas permanecem visíveis."/>
                    <Button Content="Salvar"
                            Command="{Binding SalvarPeriodoCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="12,5"
                            FontSize="12"
                            Margin="0,2,6,2"/>
                    <Button Content="Limpar"
                            Command="{Binding LimparPeriodoCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="12,5"
                            FontSize="12"
                            Margin="0,2,0,2"/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,8">
            <Border Style="{StaticResource SurfaceCardStyle}" Padding="10,8" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="PENDENTES" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}">
                        <Run Text="{Binding Painel.Pendentes, Mode=OneWay}"/>
                        <Run Text=" · R$ "/>
                        <Run Text="{Binding Painel.ValorPendentes, Mode=OneWay, StringFormat=N2}"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource PageSubtitleStyle}" FontSize="11" Margin="0,4,0,0">
                        <Run Text="{Binding Painel.Vencidas, Mode=OneWay}"/>
                        <Run Text=" vencida(s) · "/>
                        <Run Text="{Binding Painel.AVencer, Mode=OneWay}"/>
                        <Run Text=" a vencer"/>
                    </TextBlock>
                    <TextBlock Text="{Binding TextoTopLojas}"
                               Style="{StaticResource PageSubtitleStyle}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SurfaceCardStyle}" Padding="10,8" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="DEVOLVIDAS AO DIST." Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}">
                        <Run Text="{Binding Painel.Devolvidas, Mode=OneWay}"/>
                        <Run Text=" · R$ "/>
                        <Run Text="{Binding Painel.ValorDevolvido, Mode=OneWay, StringFormat=N2}"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource PageSubtitleStyle}" FontSize="11" Margin="0,4,0,0">
                        <Run Text="{Binding Painel.PerdeuPrazo, Mode=OneWay}"/>
                        <Run Text=" perderam o prazo"/>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SurfaceCardStyle}" Padding="10,8" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="ABSORVIDAS" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}">
                        <Run Text="{Binding Painel.Absorvidas, Mode=OneWay}"/>
                        <Run Text=" · R$ "/>
                        <Run Text="{Binding Painel.ValorAbsorvido, Mode=OneWay, StringFormat=N2}"/>
                    </TextBlock>
                    <TextBlock Text="Dist. absorveu (sem devolução)"
                               Style="{StaticResource PageSubtitleStyle}"
                               FontSize="11"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SurfaceCardStyle}" Padding="10,8">
                <StackPanel>
                    <TextBlock Text="ANDAMENTO (PENDENTE)" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="{Binding TextoPorAndamento}"
                               Style="{StaticResource PageSubtitleStyle}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding TextoPorClasse}"
                               Style="{StaticResource PageSubtitleStyle}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding TextoPorMotivo}"
                               Style="{StaticResource PageSubtitleStyle}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Filtros compactos -->
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="190"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Text="{Binding FiltroTexto, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource ModernTextBoxStyle}"
                     Padding="10,6"
                     FontSize="12"/>

            <ComboBox Grid.Column="2"
                      ItemsSource="{Binding FiltrosModo}"
                      SelectedItem="{Binding FiltroModo}"
                      Style="{StaticResource ModernComboBoxStyle}"
                      FontSize="12"
                      Padding="8,4"/>

            <ComboBox Grid.Column="4"
                      ItemsSource="{Binding FiltrosAndamento}"
                      SelectedItem="{Binding FiltroAndamento}"
                      Style="{StaticResource ModernComboBoxStyle}"
                      FontSize="12"
                      Padding="8,4"
                      ToolTip="Andamento da tratativa"/>
        </Grid>

        <!-- Grade principal (ocupa o espaco restante) -->
        <Border Grid.Row="4"
                Style="{StaticResource SurfaceCardStyle}"
                Padding="4"
                Margin="0,0,0,8">
            <DataGrid x:Name="GrdDevolucoes"
                      ItemsSource="{Binding Devolucoes}"
                      SelectedItem="{Binding Selecionada}"
                      Style="{StaticResource ModernDataGridStyle}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      RowHeaderWidth="0"
                      VerticalAlignment="Stretch"
                      HorizontalAlignment="Stretch"
                      PreviewKeyDown="GrdDevolucoes_PreviewKeyDown"
                      MouseDoubleClick="GrdDevolucoes_MouseDoubleClick">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="MinHeight" Value="30"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Urgencia}" Value="Vencida">
                                <Setter Property="Background" Value="#33FF0000"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusRotulo}" Width="110"/>
                    <DataGridTextColumn Header="Andamento" Binding="{Binding AndamentoRotulo}" Width="130">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="#ffff00"/>
                                <Setter Property="Foreground" Value="#1A1A1A"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="6,0">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Andamento}" Value="EnviarXml">
                                        <Setter Property="Background" Value="#e06666"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Andamento}" Value="AguardandoLoja">
                                        <Setter Property="Background" Value="#ffff00"/>
                                        <Setter Property="Foreground" Value="#1A1A1A"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Andamento}" Value="AguardandoDist">
                                        <Setter Property="Background" Value="#ffc000"/>
                                        <Setter Property="Foreground" Value="#1A1A1A"/>
                                    </DataTrigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="BorderBrush" Value="#1A1A1A"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Loja" Binding="{Binding ApelidoLoja}" Width="100"/>
                    <DataGridTextColumn Header="Nota" Binding="{Binding NumNota}" Width="85">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Distribuidora" Binding="{Binding NomeForn}" Width="*" MinWidth="120"/>
                    <DataGridTextColumn Header="Emissao" Binding="{Binding DataEmissao}" Width="95"/>
                    <DataGridTextColumn Header="Limite" Binding="{Binding DataLimiteTexto}" Width="95"/>
                    <DataGridTextColumn Header="Prazo" Binding="{Binding SituacaoPrazo}" Width="150"/>
                    <DataGridTextColumn Header="Valor" Binding="{Binding ValorNota, StringFormat=N2}" Width="85"/>
                    <DataGridTextColumn Header="Marcada" Binding="{Binding DataMarcada}" Width="95"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="4"
                Background="{DynamicResource Brush.Overlay}"
                CornerRadius="14"
                Visibility="{Binding IsCarregando, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="Carregando..."
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="16"
                       Foreground="{DynamicResource Brush.TextPrimary}"/>
        </Border>

        <!-- Detalhe / acoes compactos -->
        <Border Grid.Row="5"
                Style="{StaticResource SurfaceCardStyle}"
                Padding="10,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Style="{StaticResource PageSubtitleStyle}"
                           FontSize="12"
                           Margin="0,0,0,6"
                           TextWrapping="Wrap">
                    <Run Text="{Binding Selecionada.NomeForn, Mode=OneWay, TargetNullValue='Selecione uma nota na lista'}"/>
                    <Run Text=" · "/>
                    <Run Text="Nota "/>
                    <Run Text="{Binding Selecionada.NumNota, Mode=OneWay}"/>
                    <Run Text=" · "/>
                    <Run Text="{Binding Selecionada.ApelidoLoja, Mode=OneWay}"/>
                    <Run Text=" · "/>
                    <Run Text="{Binding Selecionada.SituacaoPrazo, Mode=OneWay}"/>
                </TextBlock>

                <TextBlock Grid.Row="1"
                           Style="{StaticResource PageSubtitleStyle}"
                           FontSize="11"
                           Margin="0,0,0,6"
                           TextWrapping="Wrap"
                           Text="{Binding TextoItensPreNota}"/>

                <ScrollViewer Grid.Row="2"
                              MaxHeight="72"
                              Margin="0,0,0,6"
                              VerticalScrollBarVisibility="Auto">
                    <TextBlock Style="{StaticResource PageSubtitleStyle}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Text="{Binding TextoHistoricoObservacoes}"/>
                </ScrollViewer>

                <DockPanel Grid.Row="3" LastChildFill="True" Margin="0,0,0,6">
                    <ComboBox DockPanel.Dock="Left"
                              Width="180"
                              Margin="0,0,8,0"
                              ItemsSource="{Binding Andamentos}"
                              DisplayMemberPath="Rotulo"
                              SelectedValuePath="Valor"
                              SelectedValue="{Binding AndamentoSelecionado}"
                              Style="{StaticResource ModernComboBoxStyle}"
                              FontSize="12"
                              Padding="8,4"
                              IsEnabled="{Binding Selecionada.PodeConcluir, FallbackValue=False, TargetNullValue=False}"
                              ToolTip="Próximo passo da tratativa (só em notas abertas)"/>
                    <Button DockPanel.Dock="Left"
                            Content="Salvar andamento"
                            Command="{Binding SalvarAndamentoCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="12,5"
                            FontSize="12"
                            Margin="0,0,8,0"/>
                    <TextBox Text="{Binding ObservacaoTexto, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Padding="10,6"
                             AcceptsReturn="False"
                             ToolTip="Novo recado (nao apaga o historico)"/>
                </DockPanel>

                <WrapPanel Grid.Row="4">
                    <Button Content="Salvar observação"
                            Command="{Binding SalvarObservacaoCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="12,5"
                            FontSize="12"
                            Margin="0,0,6,0"/>
                    <Button Content="Ver / confirmar itens"
                            Command="{Binding AbrirItensCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="12,5"
                            FontSize="12"
                            Margin="0,0,6,0"/>
                    <Button Content="Devolvida ao dist."
                            Command="{Binding MarcarDevolvidaCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="12,5"
                            FontSize="12"
                            Margin="0,0,6,0"/>
                    <Button Content="Absorvido"
                            Command="{Binding MarcarAbsorvidoCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="12,5"
                            FontSize="12"
                            Margin="0,0,6,0"/>
                    <Button Content="Perdeu o prazo"
                            Command="{Binding MarcarPerdeuPrazoCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="12,5"
                            FontSize="12"/>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
