<Window x:Class="ConferenciaNFs.Views.DetalheNotaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ConferenciaNFs.Controls"
        Title="Itens da nota"
        Height="640"
        Width="1080"
        MinHeight="420"
        MinWidth="760"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}"
        FontFamily="{StaticResource Font.Primary}">

    <Window.Resources>
        <Style x:Key="DetalheNotaHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DetalheNotaCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DetalheNotaCellTextoStyle" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="36" Height="36"
                    CornerRadius="8"
                    Background="#0B0B0B"
                    Padding="4"
                    Margin="0,0,10,0"
                    VerticalAlignment="Top">
                <Image Source="pack://application:,,,/Assets/logo-mark.png"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                <TextBlock Text="{Binding TituloNota}"
                           Style="{StaticResource PageTitleStyle}"
                           FontSize="20"
                           TextWrapping="Wrap"/>
                <TextBlock Text="{Binding SubtituloNota}"
                           Style="{StaticResource PageSubtitleStyle}"
                           Margin="0,2,0,0"
                           FontSize="12"
                           TextWrapping="Wrap"/>
                <TextBlock Text="{Binding MensagemStatus}"
                           Style="{StaticResource PageSubtitleStyle}"
                           Margin="0,2,0,0"
                           FontSize="12"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Top">
                <controls:ThemeToggle Margin="0,0,6,0"/>
                <controls:PinWindowToggle Margin="0,0,6,0"/>
                <Button Content="Fechar"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="12,6"
                        FontSize="12"
                        Click="Fechar_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Style="{StaticResource EmptyStateBorderStyle}"
                Visibility="{Binding EstaVazio, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="Nenhum item para exibir."
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.TextPrimary}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource SurfaceCardStyle}"
                Padding="0"
                Visibility="{Binding EstaVazio, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <DataGrid x:Name="GrdItens"
                      ItemsSource="{Binding Itens}"
                      SelectedItem="{Binding ItemSelecionado, Mode=TwoWay}"
                      Style="{StaticResource ModernDataGridStyle}"
                      ColumnHeaderStyle="{StaticResource DetalheNotaHeaderStyle}"
                      CellStyle="{StaticResource DetalheNotaCellStyle}"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource Brush.Border}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      CanUserReorderColumns="False"
                      HeadersVisibility="Column"
                      RowHeaderWidth="0"
                      MouseDoubleClick="GrdItens_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Codigo"
                                        Binding="{Binding CodProd}"
                                        Width="90"
                                        MinWidth="80"
                                        ElementStyle="{StaticResource DetalheNotaCellTextoStyle}"/>
                    <DataGridTextColumn Header="EAN"
                                        Binding="{Binding BarrasEan}"
                                        Width="140"
                                        MinWidth="120"
                                        ElementStyle="{StaticResource DetalheNotaCellTextoStyle}"/>
                    <DataGridTextColumn Header="Produto"
                                        Binding="{Binding NomeProd}"
                                        Width="*"
                                        MinWidth="180"
                                        ElementStyle="{StaticResource DetalheNotaCellTextoStyle}"/>
                    <DataGridTextColumn Header="Qtd"
                                        Binding="{Binding QuantItemCompra, StringFormat=N3}"
                                        Width="80"
                                        MinWidth="70"
                                        ElementStyle="{StaticResource DetalheNotaCellTextoStyle}"/>
                    <DataGridTextColumn Header="Custo"
                                        Binding="{Binding CustoUnit, StringFormat='R$ {0:N2}'}"
                                        Width="100"
                                        MinWidth="90"
                                        ElementStyle="{StaticResource DetalheNotaCellTextoStyle}"/>
                    <DataGridTextColumn Header="Lote"
                                        Binding="{Binding NumLote}"
                                        Width="100"
                                        MinWidth="80"
                                        ElementStyle="{StaticResource DetalheNotaCellTextoStyle}"/>
                    <DataGridTextColumn Header="Validade"
                                        Binding="{Binding DataValidade, StringFormat=dd/MM/yyyy}"
                                        Width="100"
                                        MinWidth="90"
                                        ElementStyle="{StaticResource DetalheNotaCellTextoStyle}"/>
                    <DataGridTextColumn Header="Conferida"
                                        Binding="{Binding QuantConferida, StringFormat=N3}"
                                        Width="90"
                                        MinWidth="80"
                                        ElementStyle="{StaticResource DetalheNotaCellTextoStyle}"/>
                    <DataGridTextColumn Header="Devolvida"
                                        Binding="{Binding QuantDevol, StringFormat=N3}"
                                        Width="90"
                                        MinWidth="80"
                                        ElementStyle="{StaticResource DetalheNotaCellTextoStyle}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="1"
                Background="{DynamicResource Brush.Overlay}"
                CornerRadius="14"
                Visibility="{Binding IsCarregando, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="Carregando itens..."
                       FontSize="16"
                       Foreground="{DynamicResource Brush.TextPrimary}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <TextBlock Grid.Row="2"
                   Margin="0,10,0,0"
                   FontSize="12"
                   Foreground="{DynamicResource Brush.TextSecondary}"
                   TextWrapping="Wrap"
                   Text="{Binding TextoResumo}"/>
    </Grid>
</Window>
