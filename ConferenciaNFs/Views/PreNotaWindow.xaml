<Window x:Class="ConferenciaNFs.Views.PreNotaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ConferenciaNFs.Controls"
        Title="{Binding Titulo}"
        Height="640"
        Width="1180"
        MinHeight="480"
        MinWidth="900"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}"
        FontFamily="{StaticResource Font.Primary}">

    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <controls:ThemeToggle DockPanel.Dock="Right" Margin="6,0,0,0" VerticalAlignment="Top"/>
            <StackPanel>
                <TextBlock Text="{Binding Titulo}"
                           Style="{StaticResource PageTitleStyle}"
                           FontSize="20"
                           TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Mensagem}"
                           Style="{StaticResource PageSubtitleStyle}"
                           FontSize="12"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource SurfaceCardStyle}"
                    Padding="0"
                    Margin="0,0,10,0">
            <DataGrid ItemsSource="{Binding Linhas}"
                      Style="{StaticResource ModernDataGridStyle}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Dev." Width="50">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Selecionado, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding DataContext.PodeEditar, RelativeSource={RelativeSource AncestorType=Window}}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Cod" Binding="{Binding CodProd}" Width="70" IsReadOnly="True"/>
                    <DataGridTextColumn Header="EAN" Binding="{Binding BarrasEan}" Width="130" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Produto" Binding="{Binding NomeProd}" Width="*" MinWidth="160" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Qtd NF" Binding="{Binding QuantidadeNota, StringFormat=N3}" Width="70" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Custo" Binding="{Binding CustoNota, StringFormat='R$ {0:N2}'}" Width="90" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="Qtd devolver" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding QuantidadeDevolver, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding DataContext.PodeEditar, RelativeSource={RelativeSource AncestorType=Window}}"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         Padding="6,4"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource SurfaceCardStyle}"
                    Padding="14,12"
                    VerticalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="Aplicar aos marcados"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="Motivo"
                               FontSize="12"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Motivos}"
                              SelectedItem="{Binding MotivoLote, UpdateSourceTrigger=PropertyChanged}"
                              IsEnabled="{Binding PodeEditar}"
                              IsEditable="False"
                              Margin="0,0,0,10"/>
                    <TextBlock Text="Classe"
                               FontSize="12"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Classes}"
                              SelectedItem="{Binding ClasseLote, UpdateSourceTrigger=PropertyChanged}"
                              IsEnabled="{Binding PodeEditar}"
                              IsEditable="False"
                              Margin="0,0,0,12"/>
                    <Button Content="Aplicar aos marcados"
                            Command="{Binding AplicarMotivoClasseMarcadosCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Padding="12,8"
                            Margin="0,0,0,16"/>
                    <TextBlock Text="Resumo"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding TextoResumo}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.TextPrimary}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2">
            <WrapPanel DockPanel.Dock="Right">
                <Button Content="{Binding TextoCancelar}"
                        Click="Cancelar_Click"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="14,7"
                        Margin="0,0,8,0"/>
                <Button Content="{Binding TextoBotaoConfirmar}"
                        Command="{Binding ConfirmarCommand}"
                        Visibility="{Binding PodeEditar, Converter={StaticResource BoolToVisibilityConverter}}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Padding="14,7"/>
            </WrapPanel>
        </DockPanel>
    </Grid>
</Window>
