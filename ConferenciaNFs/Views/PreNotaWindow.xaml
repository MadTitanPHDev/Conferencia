<Window x:Class="ConferenciaNFs.Views.PreNotaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ConferenciaNFs.Controls"
        Title="{Binding Titulo}"
        Height="640"
        Width="1100"
        MinHeight="480"
        MinWidth="860"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}"
        FontFamily="{StaticResource Font.Primary}">

    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <controls:ThemeToggle DockPanel.Dock="Right" Margin="6,0,0,0" VerticalAlignment="Top"/>
            <StackPanel>
                <TextBlock Text="{Binding Titulo}"
                           Style="{StaticResource PageTitleStyle}"
                           FontSize="20"
                           TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Mensagem}"
                           Style="{StaticResource PageSubtitleStyle}"
                           FontSize="12"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1"
                Style="{StaticResource SurfaceCardStyle}"
                Padding="0"
                Margin="0,0,0,10">
            <DataGrid ItemsSource="{Binding Linhas}"
                      Style="{StaticResource ModernDataGridStyle}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Dev." Width="50">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Selecionado, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding DataContext.PodeEditar, RelativeSource={RelativeSource AncestorType=Window}}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Cod" Binding="{Binding CodProd}" Width="70" IsReadOnly="True"/>
                    <DataGridTextColumn Header="EAN" Binding="{Binding BarrasEan}" Width="130" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Produto" Binding="{Binding NomeProd}" Width="*" MinWidth="160" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Qtd NF" Binding="{Binding QuantidadeNota, StringFormat=N3}" Width="70" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Custo" Binding="{Binding CustoNota, StringFormat='R$ {0:N2}'}" Width="90" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="Qtd devolver" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding QuantidadeDevolver, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding DataContext.PodeEditar, RelativeSource={RelativeSource AncestorType=Window}}"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         Padding="6,4"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Motivo" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.Motivos, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding Motivo, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding DataContext.PodeEditar, RelativeSource={RelativeSource AncestorType=Window}}"
                                          IsEditable="False"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Classe" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.Classes, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding Classe, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding DataContext.PodeEditar, RelativeSource={RelativeSource AncestorType=Window}}"
                                          IsEditable="False"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <DockPanel Grid.Row="2">
            <WrapPanel DockPanel.Dock="Right">
                <Button Content="{Binding TextoCancelar}"
                        Click="Cancelar_Click"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="14,7"
                        Margin="0,0,8,0"/>
                <Button Content="{Binding TextoBotaoConfirmar}"
                        Command="{Binding ConfirmarCommand}"
                        Visibility="{Binding PodeEditar, Converter={StaticResource BoolToVisibilityConverter}}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Padding="14,7"/>
            </WrapPanel>
        </DockPanel>
    </Grid>
</Window>
