<Window x:Class="ConferenciaNFs.Views.PesquisarProdutoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ConferenciaNFs.Controls"
        Title="Pesquisar produto"
        Height="720"
        Width="1180"
        MinHeight="520"
        MinWidth="800"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}"
        FontFamily="{StaticResource Font.Primary}">

    <Window.Resources>
        <Style x:Key="PesquisaEanHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PesquisaEanCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PesquisaEanCellTextoStyle" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="36" Height="36"
                    CornerRadius="8"
                    Background="#0B0B0B"
                    Padding="4"
                    Margin="0,0,10,0"
                    VerticalAlignment="Top">
                <Image Source="pack://application:,,,/Assets/logo-mark.png"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                <TextBlock Text="Pesquisar produto"
                           Style="{StaticResource PageTitleStyle}"
                           FontSize="22"
                           TextWrapping="Wrap"/>
                <TextBlock Text="{Binding MensagemPesquisa}"
                           Style="{StaticResource PageSubtitleStyle}"
                           Margin="0,4,0,0"
                           FontSize="12"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                <controls:ThemeToggle Margin="0,0,6,0"/>
                <controls:PinWindowToggle Margin="0,0,6,0"/>
                <Button Content="Fechar"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="12,6"
                        FontSize="12"
                        Click="Fechar_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Style="{StaticResource SurfaceCardStyle}"
                Padding="12,10"
                Margin="0,0,0,12">
            <WrapPanel VerticalAlignment="Center">
                <StackPanel Margin="0,4,16,4" VerticalAlignment="Center">
                    <TextBlock Text="EAN" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,4"/>
                    <TextBox Width="200"
                             Text="{Binding EanPesquisa, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Padding="10,6">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding PesquisarCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </StackPanel>

                <StackPanel Margin="0,4,16,4" VerticalAlignment="Center">
                    <TextBlock Text="A partir de" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding DataInicio, Mode=TwoWay}"
                                Language="pt-BR"
                                Width="150"
                                VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Margin="0,4,16,4" VerticalAlignment="Center">
                    <TextBlock Text="Custo minimo (opcional)" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,4"/>
                    <TextBox Width="120"
                             Text="{Binding CustoMinimoTexto, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Padding="10,6"
                             ToolTip="Ex.: 12,03 — lista so itens com custo acima deste valor."/>
                </StackPanel>

                <Button Content="Pesquisar"
                        Command="{Binding PesquisarCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,22,8,4"
                        VerticalAlignment="Center"/>
                <Button Content="Limpar"
                        Command="{Binding LimparCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,22,0,4"
                        VerticalAlignment="Center"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource EmptyStateBorderStyle}"
                Visibility="{Binding PesquisaRealizada, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <TextBlock Text="Informe o EAN e clique em Pesquisar."
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.TextPrimary}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource SurfaceCardStyle}"
                Padding="0"
                Visibility="{Binding ExibirResultados, Converter={StaticResource BoolToVisibilityConverter}}">
            <DataGrid x:Name="GrdResultados"
                      ItemsSource="{Binding Resultados}"
                      SelectedItem="{Binding ItemSelecionado, Mode=TwoWay}"
                      Style="{StaticResource ModernDataGridStyle}"
                      ColumnHeaderStyle="{StaticResource PesquisaEanHeaderStyle}"
                      CellStyle="{StaticResource PesquisaEanCellStyle}"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource Brush.Border}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      CanUserReorderColumns="False"
                      HeadersVisibility="Column"
                      RowHeaderWidth="0"
                      PreviewMouseRightButtonDown="GrdResultados_PreviewMouseRightButtonDown"
                      PreviewKeyDown="GrdResultados_PreviewKeyDown"
                      MouseDoubleClick="GrdResultados_MouseDoubleClick">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copiar numero da nota"
                                  InputGestureText="Ctrl+C"
                                  Command="{Binding CopiarNumeroNotaCommand}"/>
                        <MenuItem Header="Abrir itens da nota"
                                  Command="{Binding AbrirItensCommand}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Data"
                                        Binding="{Binding DataCompra}"
                                        Width="100"
                                        ElementStyle="{StaticResource PesquisaEanCellTextoStyle}"/>
                    <DataGridTextColumn Header="Loja"
                                        Binding="{Binding Loja}"
                                        Width="120"
                                        ElementStyle="{StaticResource PesquisaEanCellTextoStyle}"/>
                    <DataGridTextColumn Header="Nota"
                                        Binding="{Binding NumNota}"
                                        Width="90"
                                        ElementStyle="{StaticResource PesquisaEanCellTextoStyle}"/>
                    <DataGridTextColumn Header="Produto"
                                        Binding="{Binding NomeProd}"
                                        Width="*"
                                        MinWidth="160"
                                        ElementStyle="{StaticResource PesquisaEanCellTextoStyle}"/>
                    <DataGridTextColumn Header="Codigo"
                                        Binding="{Binding CodProd}"
                                        Width="80"
                                        ElementStyle="{StaticResource PesquisaEanCellTextoStyle}"/>
                    <DataGridTextColumn Header="EAN"
                                        Binding="{Binding BarrasEan}"
                                        Width="130"
                                        ElementStyle="{StaticResource PesquisaEanCellTextoStyle}"/>
                    <DataGridTextColumn Header="Qtd"
                                        Binding="{Binding Quantidade, StringFormat=N3}"
                                        Width="70"
                                        ElementStyle="{StaticResource PesquisaEanCellTextoStyle}"/>
                    <DataGridTextColumn Header="Custo"
                                        Binding="{Binding Custo, StringFormat='R$ {0:N2}'}"
                                        Width="90"
                                        ElementStyle="{StaticResource PesquisaEanCellTextoStyle}"/>
                    <DataGridTextColumn Header="Status"
                                        Binding="{Binding StatusRotulo}"
                                        Width="110"
                                        ElementStyle="{StaticResource PesquisaEanCellTextoStyle}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2"
                Background="{DynamicResource Brush.Overlay}"
                CornerRadius="14"
                Visibility="{Binding IsPesquisando, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="Buscando..."
                       FontSize="16"
                       Foreground="{DynamicResource Brush.TextPrimary}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <TextBlock Grid.Row="3"
                   Margin="0,10,0,0"
                   FontSize="12"
                   Foreground="{DynamicResource Brush.TextSecondary}"
                   TextWrapping="Wrap"
                   Text="Duplo clique ou Ctrl+C copia o numero da nota. Botao direito: copiar ou abrir itens. O custo minimo e opcional."/>
    </Grid>
</Window>
