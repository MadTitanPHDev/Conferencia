<Window x:Class="ConferenciaNFs.Views.PesquisarNotaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ConferenciaNFs.Models"
        xmlns:controls="clr-namespace:ConferenciaNFs.Controls"
        Title="Pesquisar nota fiscal"
        Height="720"
        Width="920"
        MinHeight="520"
        MinWidth="640"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}"
        FontFamily="{StaticResource Font.Primary}">

    <Grid Margin="22,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Left"
                            Width="36" Height="36"
                            CornerRadius="8"
                            Background="#0B0B0B"
                            Padding="4"
                            Margin="0,0,10,0"
                            VerticalAlignment="Top">
                        <Image Source="pack://application:,,,/Assets/logo-mark.png"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Pesquisar nota"
                                   Style="{StaticResource PageTitleStyle}"
                                   FontSize="24"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding MensagemPesquisa}"
                                   Style="{StaticResource PageSubtitleStyle}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>

            <WrapPanel Grid.Row="1" HorizontalAlignment="Left">
                <controls:ThemeToggle Margin="0,0,8,8"/>
                <controls:PinWindowToggle Margin="0,0,0,8"/>
            </WrapPanel>
        </Grid>

        <Border Grid.Row="1"
                Style="{StaticResource SurfaceCardStyle}"
                Padding="16,14"
                Margin="0,0,0,14">
            <WrapPanel VerticalAlignment="Center">
                <Border Background="{DynamicResource Brush.AccentSoft}"
                        CornerRadius="10"
                        Padding="10,8"
                        Margin="0,4,14,4"
                        VerticalAlignment="Center">
                    <TextBlock Text="Numero"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Accent}"/>
                </Border>

                <TextBox Width="220"
                         MinWidth="160"
                         Text="{Binding NumNotaPesquisa, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Margin="0,4,8,4"
                         VerticalAlignment="Center">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding PesquisarCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <Button Content="Pesquisar"
                        Command="{Binding PesquisarCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,4,8,4"
                        VerticalAlignment="Center"/>

                <Button Content="Limpar"
                        Command="{Binding LimparCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,4,12,4"
                        VerticalAlignment="Center"/>

                <TextBlock Text="Retorna o status da primeira conferencia, mesmo quando a nota se repete em outros dias."
                           Style="{StaticResource PageSubtitleStyle}"
                           FontSize="12"
                           Margin="0,4,0,4"
                           MaxWidth="320"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource SurfaceCardStyle}"
                Padding="14"
                Margin="0,0,0,14">
            <Grid>
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding PesquisaRealizada, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <TextBlock Text="Digite o numero da nota e clique em Pesquisar"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.TextPrimary}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding ExibirResultados, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding Resultados}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:NotaPesquisaResultado}">
                                <Border Style="{StaticResource SurfaceCardStyle}"
                                        Padding="14"
                                        Margin="0,0,0,10"
                                        Background="{DynamicResource Brush.SurfaceMuted}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                MinWidth="112"
                                                CornerRadius="10"
                                                Padding="14,10"
                                                Margin="0,0,16,0"
                                                VerticalAlignment="Center"
                                                Background="{Binding CorHex, Converter={StaticResource HexToBrushConverter}}"
                                                BorderBrush="{DynamicResource Brush.Border}"
                                                BorderThickness="1">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding StatusRotulo}"
                                                           FontWeight="Bold"
                                                           FontSize="16"
                                                           Foreground="{Binding TextoCorHex, Converter={StaticResource HexToBrushConverter}}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding StatusDescricao}"
                                                           FontSize="11"
                                                           Foreground="{Binding TextoCorHex, Converter={StaticResource HexToBrushConverter}}"
                                                           HorizontalAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock FontWeight="SemiBold" FontSize="15"
                                                       Foreground="{DynamicResource Brush.TextPrimary}">
                                                <Run Text="Nota "/><Run Text="{Binding NumNota}"/>
                                                <Run Text=" · "/><Run Text="{Binding NomeForn}"/>
                                            </TextBlock>
                                            <TextBlock Margin="0,6,0,0" Style="{StaticResource PageSubtitleStyle}">
                                                <Run Text="Primeira conferencia em "/><Run Text="{Binding DataPrimeiraConferencia}"/>
                                                <Run Text=" · Loja "/><Run Text="{Binding ApelidoLoja}"/>
                                            </TextBlock>
                                            <TextBlock Margin="0,4,0,0" Style="{StaticResource PageSubtitleStyle}">
                                                <Run Text="Repeticoes no historico: "/><Run Text="{Binding OcorrenciasTotais}"/>
                                            </TextBlock>
                                            <TextBlock Margin="0,4,0,0"
                                                       Style="{StaticResource PageSubtitleStyle}"
                                                       Text="{Binding Observacao, StringFormat='Observacao: {0}'}"
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding Observacao, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Background="{DynamicResource Brush.Overlay}"
                        CornerRadius="12"
                        Visibility="{Binding IsPesquisando, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Buscando..."
                               FontSize="15"
                               Foreground="{DynamicResource Brush.TextPrimary}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <WrapPanel Grid.Row="3" HorizontalAlignment="Right">
            <Button Content="Fechar"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="Fechar_Click"/>
        </WrapPanel>
    </Grid>
</Window>
