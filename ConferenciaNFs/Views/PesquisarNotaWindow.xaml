<Window x:Class="ConferenciaNFs.Views.PesquisarNotaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ConferenciaNFs.Models"
        xmlns:controls="clr-namespace:ConferenciaNFs.Controls"
        Title="Pesquisar nota fiscal"
        Height="760"
        Width="980"
        MinHeight="520"
        MinWidth="680"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}"
        FontFamily="{StaticResource Font.Primary}">

    <Grid Margin="22,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Left"
                            Width="36" Height="36"
                            CornerRadius="8"
                            Background="{DynamicResource Brush.Brand}"
                            Padding="4"
                            Margin="0,0,10,0"
                            VerticalAlignment="Top">
                        <Image Source="pack://application:,,,/Assets/logo-mark.png"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Pesquisar nota"
                                   Style="{StaticResource PageTitleStyle}"
                                   FontSize="24"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding MensagemPesquisa}"
                                   Style="{StaticResource PageSubtitleStyle}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>

            <WrapPanel Grid.Row="1" HorizontalAlignment="Left">
                <controls:ThemeToggle Margin="0,0,8,8"/>
                <controls:PinWindowToggle Margin="0,0,0,8"/>
            </WrapPanel>
        </Grid>

        <Border Grid.Row="1"
                Style="{StaticResource SurfaceCardStyle}"
                Padding="16,14"
                Margin="0,0,0,14">
            <WrapPanel VerticalAlignment="Center">
                <StackPanel Margin="0,4,12,4" VerticalAlignment="Center">
                    <TextBlock Text="Número, loja ou fornecedor"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="0,0,0,4"/>
                    <TextBox Width="240"
                             MinWidth="180"
                             Text="{Binding TermoPesquisa, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBoxStyle}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding PesquisarCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </StackPanel>

                <StackPanel Margin="0,4,12,4" VerticalAlignment="Center">
                    <TextBlock Text="Loja"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="0,0,0,4"/>
                    <TextBox Width="140"
                             Text="{Binding FiltroLoja, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBoxStyle}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding PesquisarCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </StackPanel>

                <StackPanel Margin="0,4,12,4" VerticalAlignment="Center">
                    <TextBlock Text="Status"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="0,0,0,4"/>
                    <ComboBox Width="220"
                              ItemsSource="{Binding StatusOpcoes}"
                              SelectedItem="{Binding StatusSelecionado}"
                              DisplayMemberPath="Rotulo"
                              Style="{StaticResource ModernComboBoxStyle}"/>
                </StackPanel>

                <StackPanel Margin="0,4,12,4" VerticalAlignment="Center">
                    <TextBlock Text="De"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding DataInicio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Language="pt-BR"
                                Width="148"/>
                </StackPanel>

                <StackPanel Margin="0,4,12,4" VerticalAlignment="Center">
                    <TextBlock Text="Até"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding DataFim, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Language="pt-BR"
                                Width="148"/>
                </StackPanel>

                <Button Content="Pesquisar"
                        Command="{Binding PesquisarCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,22,8,4"
                        VerticalAlignment="Center"/>

                <Button Content="Limpar"
                        Command="{Binding LimparCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,22,0,4"
                        VerticalAlignment="Center"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource SurfaceCardStyle}"
                Padding="14"
                Margin="0,0,0,14">
            <Grid>
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding PesquisaRealizada, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <TextBlock Text="Informe um filtro e clique em Pesquisar"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.TextPrimary}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Zeros a esquerda e trechos do numero tambem encontram a nota."
                               Style="{StaticResource PageSubtitleStyle}"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding ExibirResultados, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding Resultados}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:NotaPesquisaResultado}">
                                <Border Style="{StaticResource SurfaceCardStyle}"
                                        Padding="14"
                                        Margin="0,0,0,10"
                                        Background="{DynamicResource Brush.SurfaceMuted}">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftDoubleClick"
                                                      Command="{Binding DataContext.AbrirConferenciaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                MinWidth="112"
                                                CornerRadius="10"
                                                Padding="14,10"
                                                Margin="0,0,16,0"
                                                VerticalAlignment="Center"
                                                Background="{Binding CorHex, Converter={StaticResource HexToBrushConverter}}"
                                                BorderBrush="{DynamicResource Brush.Border}"
                                                BorderThickness="1">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding StatusRotulo}"
                                                           FontWeight="Bold"
                                                           FontSize="16"
                                                           Foreground="{Binding TextoCorHex, Converter={StaticResource HexToBrushConverter}}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding StatusDescricao}"
                                                           FontSize="11"
                                                           Foreground="{Binding TextoCorHex, Converter={StaticResource HexToBrushConverter}}"
                                                           HorizontalAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock FontWeight="SemiBold" FontSize="15"
                                                       Foreground="{DynamicResource Brush.TextPrimary}">
                                                <Run Text="Nota "/><Run Text="{Binding NumNota}"/>
                                                <Run Text=" · "/><Run Text="{Binding NomeForn}"/>
                                            </TextBlock>
                                            <TextBlock Margin="0,6,0,0" Style="{StaticResource PageSubtitleStyle}">
                                                <Run Text="Conferencia em "/><Run Text="{Binding DiaConferencia}"/>
                                                <Run Text=" · Loja "/><Run Text="{Binding ApelidoLoja}"/>
                                            </TextBlock>
                                            <TextBlock Margin="0,4,0,0"
                                                       Style="{StaticResource PageSubtitleStyle}"
                                                       Text="{Binding TextoOcorrencias}"/>
                                            <WrapPanel Margin="0,8,0,0">
                                                <Border Background="{DynamicResource Brush.AccentSoft}"
                                                        CornerRadius="8"
                                                        Padding="8,4"
                                                        Margin="0,0,8,4"
                                                        Visibility="{Binding EhPrimeiraOcorrencia, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="Primeira conferencia"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Brush.Accent}"/>
                                                </Border>
                                                <Border Background="{DynamicResource Brush.AccentSoft}"
                                                        CornerRadius="8"
                                                        Padding="8,4"
                                                        Margin="0,0,8,4"
                                                        Visibility="{Binding EstaNaFila, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding TextoFila, StringFormat='Fila: {0}'}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Brush.Accent}"/>
                                                </Border>
                                            </WrapPanel>
                                            <TextBlock Margin="0,4,0,0"
                                                       Style="{StaticResource PageSubtitleStyle}"
                                                       Text="{Binding Observacao, StringFormat='Observacao: {0}'}"
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding Observacao, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Margin="12,0,0,0">
                                            <Button Content="Abrir conferência"
                                                    Command="{Binding DataContext.AbrirConferenciaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Margin="0,0,0,8"
                                                    HorizontalAlignment="Stretch"/>
                                            <Button Content="Ir para a fila"
                                                    Command="{Binding DataContext.AbrirFilaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Visibility="{Binding EstaNaFila, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    HorizontalAlignment="Stretch"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Background="{DynamicResource Brush.Overlay}"
                        CornerRadius="12"
                        Visibility="{Binding IsPesquisando, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Buscando..."
                               FontSize="15"
                               Foreground="{DynamicResource Brush.TextPrimary}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <WrapPanel Grid.Row="3" HorizontalAlignment="Right">
            <Button Content="Fechar"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="Fechar_Click"/>
        </WrapPanel>
    </Grid>
</Window>
