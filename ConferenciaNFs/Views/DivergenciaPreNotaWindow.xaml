<Window x:Class="ConferenciaNFs.Views.DivergenciaPreNotaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Titulo}"
        Height="680"
        Width="1280"
        MinHeight="480"
        MinWidth="860"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}"
        FontFamily="{StaticResource Font.Primary}">
    <Window.Resources>
        <Style x:Key="ComparacaoPedidoTexto" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{Binding Titulo}"
                       Style="{StaticResource PageTitleStyle}"
                       FontSize="20"
                       TextWrapping="Wrap"/>
            <TextBlock Text="{Binding TextoDistribuidora}"
                       Style="{StaticResource PageSubtitleStyle}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Visibility="{Binding TextoDistribuidora, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
            <TextBlock Text="{Binding TextoRemetente}"
                       Style="{StaticResource PageSubtitleStyle}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Visibility="{Binding TextoRemetente, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
            <TextBlock Text="{Binding Mensagem}"
                       Style="{StaticResource PageSubtitleStyle}"
                       FontSize="12"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SurfaceCardStyle}" Padding="0" Margin="0,0,10,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="10,10,10,4">
                        <TextBlock Text="Pesquisar por nome ou codigo de barras"
                                   FontSize="12"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   Margin="0,0,0,4"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Content="Limpar"
                                    Command="{Binding LimparFiltroCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="10,6"
                                    Margin="8,0,0,0"
                                    FontSize="12"
                                    Visibility="{Binding TemFiltro, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <TextBox Text="{Binding FiltroTexto, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     Padding="10,6"
                                     FontSize="13"/>
                        </DockPanel>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="{Binding TextoFiltroItens}"
                               Style="{StaticResource PageSubtitleStyle}"
                               FontSize="11"
                               Margin="12,0,12,2"/>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Duplo clique na linha copia o codigo de barras. Se a janela estiver estreita, role a grade para o lado."
                               Style="{StaticResource PageSubtitleStyle}"
                               FontSize="11"
                               Margin="12,0,12,8"
                               TextWrapping="Wrap"/>
                    <DataGrid ItemsSource="{Binding LinhasView}"
                              SelectedItem="{Binding LinhaSelecionada, Mode=TwoWay}"
                              MouseDoubleClick="GrdItens_MouseDoubleClick"
                              Style="{StaticResource ModernDataGridStyle}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="72" MinWidth="72">
                                <DataGridTemplateColumn.Header>
                                    <Button Content="Todos"
                                            Command="{Binding DataContext.AlternarSelecaoTodosCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="6,2"
                                            FontSize="11"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Selecionado, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding DataContext.PodeEditar, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Cod" Binding="{Binding CodProd}" Width="70" MinWidth="70" IsReadOnly="True"/>
                            <DataGridTextColumn Header="EAN" Binding="{Binding BarrasEan}" Width="130" MinWidth="130" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="" Width="76" MinWidth="76">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Copiar"
                                                Command="{Binding DataContext.CopiarEanCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="6,2"
                                                FontSize="11"
                                                ToolTip="Copia o codigo de barras deste item"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Produto" Binding="{Binding NomeProd}" Width="220" MinWidth="180" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Comprador" Binding="{Binding CompradorNome}" Width="110" MinWidth="110" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Motivo" Binding="{Binding Motivo}" Width="160" MinWidth="140" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Preco" Binding="{Binding CustoNota, StringFormat='R$ {0:N2}'}" Width="96" MinWidth="96" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding SituacaoPedido}" Width="150" MinWidth="130" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Qtd NF" Binding="{Binding QuantidadeNota, StringFormat=N3}" Width="80" MinWidth="80" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="Qtd" Width="90" MinWidth="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Quantidade, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding DataContext.PodeEditar, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Style="{StaticResource ModernTextBoxStyle}"
                                                 Padding="6,4"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Total" Binding="{Binding TotalItem, StringFormat='R$ {0:N2}'}" Width="100" MinWidth="100" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource SurfaceCardStyle}" Padding="14,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <StackPanel Visibility="{Binding EscolhendoCompradores, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Aplicar aos marcados"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="Comprador"
                                   FontSize="12"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Pessoas}"
                                  SelectedItem="{Binding CompradorLote}"
                                  DisplayMemberPath="Nome"
                                  IsEnabled="{Binding PodeEditar}"
                                  Margin="0,0,0,10"/>
                        <TextBlock Text="Motivo"
                                   FontSize="12"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   Margin="0,0,0,4"/>
                        <TextBox Text="{Binding MotivoLote, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="70"
                                 Padding="8"
                                 Margin="0,0,0,10"/>
                        <Button Content="Aplicar aos marcados"
                                Command="{Binding AplicarCompradorCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Padding="12,8"
                                Margin="0,0,0,16"/>
                    </StackPanel>
                    <TextBlock Text="Comprador"
                               FontSize="12"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               Margin="0,0,0,4"
                               Visibility="{Binding EscolhendoCompradores, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding PessoaSelecionada.Nome}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12"
                               TextWrapping="Wrap"
                               Visibility="{Binding EscolhendoCompradores, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                    <TextBlock Text="Observacao"
                               FontSize="12"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               Margin="0,0,0,4"
                               Visibility="{Binding EscolhendoCompradores, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                    <TextBox Text="{Binding Observacao, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBoxStyle}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             IsEnabled="{Binding PodeEditar}"
                             MinHeight="70"
                             Padding="8"
                             Margin="0,0,0,12"
                             Visibility="{Binding EscolhendoCompradores, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                    <TextBlock Text="Nota x pedido"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="0,4,0,2"/>
                    <TextBlock Text="{Binding LinhaSelecionada.NomeProd}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.TextPrimary}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="68"/>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="56"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Nota" Style="{StaticResource ComparacaoPedidoTexto}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Pedidos" Style="{StaticResource ComparacaoPedidoTexto}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Dif." Style="{StaticResource ComparacaoPedidoTexto}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Quantidade" Style="{StaticResource ComparacaoPedidoTexto}" Margin="0,4,4,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LinhaSelecionada.Comparacao.QtdNota}" Style="{StaticResource ComparacaoPedidoTexto}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding LinhaSelecionada.Comparacao.QtdPedido}" Style="{StaticResource ComparacaoPedidoTexto}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding LinhaSelecionada.Comparacao.DifQtd}" HorizontalAlignment="Right" Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ComparacaoPedidoTexto}">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="0,4,0,0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LinhaSelecionada.Comparacao.DifQtdAlerta}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.DifAlerta}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Preço total" Style="{StaticResource ComparacaoPedidoTexto}" Margin="0,4,4,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LinhaSelecionada.Comparacao.PrecoTotalNota}" Style="{StaticResource ComparacaoPedidoTexto}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding LinhaSelecionada.Comparacao.PrecoTotalPedido}" Style="{StaticResource ComparacaoPedidoTexto}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding LinhaSelecionada.Comparacao.DifPrecoTotal}" HorizontalAlignment="Right" Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ComparacaoPedidoTexto}">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="0,4,0,0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LinhaSelecionada.Comparacao.DifPrecoTotalAlerta}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.DifAlerta}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Preço unit." Style="{StaticResource ComparacaoPedidoTexto}" Margin="0,4,4,0"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LinhaSelecionada.Comparacao.PrecoUnitNota}" Style="{StaticResource ComparacaoPedidoTexto}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding LinhaSelecionada.Comparacao.PrecoUnitPedido}" Style="{StaticResource ComparacaoPedidoTexto}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding LinhaSelecionada.Comparacao.DifPrecoUnit}" HorizontalAlignment="Right" Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ComparacaoPedidoTexto}">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="0,4,0,0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LinhaSelecionada.Comparacao.DifPrecoUnitAlerta}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.DifAlerta}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Desconto (%)" Style="{StaticResource ComparacaoPedidoTexto}" Margin="0,4,4,0"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LinhaSelecionada.Comparacao.DescontoNota}" Style="{StaticResource ComparacaoPedidoTexto}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding LinhaSelecionada.Comparacao.DescontoPedido}" Style="{StaticResource ComparacaoPedidoTexto}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="4" Grid.Column="3" Text="{Binding LinhaSelecionada.Comparacao.DifDesconto}" HorizontalAlignment="Right" Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ComparacaoPedidoTexto}">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="0,4,0,0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LinhaSelecionada.Comparacao.DifDescontoAlerta}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.DifAlerta}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock Text="Resumo"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding TextoResumo}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.TextPrimary}"
                               TextWrapping="Wrap"/>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2">
            <WrapPanel DockPanel.Dock="Right">
                <Button Content="{Binding TextoCancelar}"
                        Click="Cancelar_Click"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="14,7"
                        Margin="0,0,8,0"/>
                <Button Content="{Binding TextoBotaoConfirmar}"
                        Command="{Binding ConfirmarCommand}"
                        Visibility="{Binding PodeEditar, Converter={StaticResource BoolToVisibilityConverter}}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="14,7"/>
            </WrapPanel>
            <WrapPanel HorizontalAlignment="Left"
                       Visibility="{Binding MostrarResposta, Converter={StaticResource BoolToVisibilityConverter}}">
                <Button Content="Ficar com a divergencia"
                        Command="{Binding FicarCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Padding="14,7"
                        Margin="0,0,8,0"
                        ToolTip="A nota volta para Verde. A pendencia fica concluida."/>
                <Button Content="Devolver"
                        Command="{Binding DevolverCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="14,7"
                        ToolTip="A nota entra na fila de devolucoes. A pendencia fica concluida."/>
            </WrapPanel>
        </DockPanel>
    </Grid>
</Window>
