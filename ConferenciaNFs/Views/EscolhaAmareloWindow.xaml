<Window x:Class="ConferenciaNFs.Views.EscolhaAmareloWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Amarelo"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{DynamicResource Brush.Background}"
        FontFamily="{StaticResource Font.Primary}">
    <StackPanel Margin="20">
        <TextBlock Text="O que fazer com esta nota?"
                   Style="{StaticResource PageTitleStyle}"
                   FontSize="18"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"/>
        <TextBlock Text="Enviar abre a pre-nota para uma pessoa do cadastro. A nota continua na conferencia. So deixar amarelo nao cria pendencia."
                   Style="{StaticResource PageSubtitleStyle}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16"/>
        <Button Content="Enviar ao comprador"
                Click="Enviar_Click"
                Style="{StaticResource PrimaryButtonStyle}"
                HorizontalAlignment="Stretch"
                Padding="12,8"
                Margin="0,0,0,8"/>
        <Button Content="So deixar amarelo para nos"
                Click="Somente_Click"
                Style="{StaticResource SecondaryButtonStyle}"
                HorizontalAlignment="Stretch"
                Padding="12,8"
                Margin="0,0,0,8"/>
        <Button Content="Cancelar"
                IsCancel="True"
                Style="{StaticResource SecondaryButtonStyle}"
                HorizontalAlignment="Stretch"
                Padding="12,8"/>
    </StackPanel>
</Window>
