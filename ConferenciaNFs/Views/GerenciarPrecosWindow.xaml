<Window x:Class="ConferenciaNFs.Views.GerenciarPrecosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ConferenciaNFs.Controls"
        Title="Tabelas de preco"
        Height="640"
        Width="860"
        MinHeight="480"
        MinWidth="640"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}"
        FontFamily="{StaticResource Font.Primary}">

    <Grid Margin="22,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Border DockPanel.Dock="Left"
                    Width="36" Height="36"
                    CornerRadius="8"
                    Background="#0B0B0B"
                    Padding="4"
                    Margin="0,0,10,0"
                    VerticalAlignment="Top">
                <Image Source="pack://application:,,,/Assets/logo-mark.png"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <StackPanel>
                <TextBlock Text="Tabelas de preco"
                           Style="{StaticResource PageTitleStyle}"
                           FontSize="24"
                           TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Mensagem}"
                           Style="{StaticResource PageSubtitleStyle}"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1"
                Style="{StaticResource SurfaceCardStyle}"
                Padding="14"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="NOVA IMPORTACAO"
                           Style="{StaticResource SectionTitleStyle}"
                           Margin="0,0,0,10"/>
                <TextBlock Text="Colunas: 1 EAN, 2 nome, 3 preco primario, 4 preco secundario (opcional). Sem cabecalho."
                           Style="{StaticResource PageSubtitleStyle}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Content="Importar Excel"
                            Command="{Binding ImportarCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="14,8"
                            Margin="8,0,0,0"/>
                    <TextBox Text="{Binding NovoNome, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Padding="10,8"
                             Tag="Nome da tabela (ex.: PANVEL MAR/26)"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource SurfaceCardStyle}"
                Padding="10"
                Margin="0,0,0,12">
            <DataGrid ItemsSource="{Binding Importacoes}"
                      SelectedItem="{Binding Selecionada, Mode=TwoWay}"
                      Style="{StaticResource ModernDataGridStyle}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*" MinWidth="160"/>
                    <DataGridTextColumn Header="Itens" Binding="{Binding QuantidadeItens}" Width="80"/>
                    <DataGridTextColumn Header="Importada em" Binding="{Binding CriadaEm}" Width="160"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <DockPanel Grid.Row="3">
            <WrapPanel DockPanel.Dock="Left">
                <controls:ThemeToggle Margin="0,0,8,0"/>
                <controls:PinWindowToggle/>
            </WrapPanel>
            <WrapPanel HorizontalAlignment="Right">
                <Button Content="Excluir selecionada"
                        Command="{Binding ExcluirCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0"/>
                <Button Content="Atualizar"
                        Command="{Binding AtualizarCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0"/>
                <Button Content="Fechar"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Fechar_Click"/>
            </WrapPanel>
        </DockPanel>
    </Grid>
</Window>
